<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <!-- Hero Section -->
  <header class="hero-section text-center text-lg-start">
    <div class="container position-relative" style="z-index: 2;">
      <div class="row align-items-center g-5">
        <div class="col-lg-7">
          <span class="badge bg-white text-primary fw-bold px-3 py-2 rounded-pill mb-3 shadow-sm">
            Campus Venue Management System
          </span>
          <h1 class="hero-title mb-4">Find the Right Venue for Your Next Event</h1>
          <p class="hero-subtitle mb-4">
            Search campus venues, check availability and manage your event bookings from one place. Clash-free scheduling, transparent facilities, and instant booking workflows.
          </p>
          <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
            <a href="/venues" class="btn btn-light btn-lg px-4 py-3 fw-bold text-primary shadow">
              Explore Venues
            </a>
            <% if (isAuthenticated) { %>
              <a href="/venues" class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold">
                Book a Venue
              </a>
            <% } else { %>
              <a href="/register" class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold">
                Get Started
              </a>
            <% } %>
          </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block">
          <div class="card card-custom p-4 text-dark shadow-lg border-0 bg-white" style="border-radius: 24px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="fw-bold text-dark">Quick Campus Snapshot</span>
              <span class="badge bg-success-subtle text-success border border-success-subtle">Live System</span>
            </div>
            <div class="row g-3">
              <div class="col-6">
                <div class="p-3 bg-light rounded-3 text-center">
                  <div class="fs-2 fw-bold text-primary"><%= stats.venueCount %></div>
                  <div class="text-muted small">Campus Venues</div>
                </div>
              </div>
              <div class="col-6">
                <div class="p-3 bg-light rounded-3 text-center">
                  <div class="fs-2 fw-bold text-success"><%= stats.completedEventCount %></div>
                  <div class="text-muted small">Completed Events</div>
                </div>
              </div>
              <div class="col-12">
                <div class="p-3 bg-light rounded-3 d-flex align-items-center gap-3">
                  <div class="stat-icon primary" style="width: 44px; height: 44px; font-size: 1.25rem;">⚡</div>
                  <div>
                    <div class="fw-bold small text-dark">Real-Time Conflict Prevention</div>
                    <div class="text-muted" style="font-size: 0.8rem;">Zero double bookings with automated overlap detection</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Flash Messages -->
  <div class="container mt-4">
    <%- include('partials/flash') %>
  </div>

  <!-- Featured Venues Section -->
  <section class="py-5">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
          <span class="text-primary text-uppercase fw-bold small">Campus Spaces</span>
          <h2 class="fw-bold text-dark mb-0">Featured Venues</h2>
        </div>
        <a href="/venues" class="text-primary fw-semibold text-decoration-none">
          View All Venues &rarr;
        </a>
      </div>

      <div class="row g-4">
        <% if (featuredVenues && featuredVenues.length > 0) { %>
          <% featuredVenues.forEach(function(venue) { %>
            <div class="col-md-6 col-lg-4">
              <div class="card card-custom h-100">
                <img src="<%= venue.imageUrl %>" class="card-venue-img" alt="<%= venue.name %>" onerror="this.src='https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=800&q=80'">
                <div class="card-body p-4 d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title fw-bold text-dark mb-0"><%= venue.name %></h5>
                    <span class="badge badge-status <%= venue.status === 'active' ? 'badge-active' : 'badge-inactive' %>">
                      <%= venue.status %>
                    </span>
                  </div>
                  <p class="text-muted small mb-2">📍 <%= venue.location %></p>
                  <p class="text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= venue.description %>
                  </p>

                  <div class="d-flex flex-wrap gap-1 mb-3">
                    <% (venue.facilities || []).slice(0, 3).forEach(function(f) { %>
                      <span class="facility-pill"><%= f %></span>
                    <% }); %>
                    <% if (venue.facilities && venue.facilities.length > 3) { %>
                      <span class="facility-pill">+<%= venue.facilities.length - 3 %> more</span>
                    <% } %>
                  </div>

                  <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                    <div>
                      <div class="fw-bold text-dark"><%= formatCurrency(venue.hourlyRate) %><span class="text-muted fw-normal small">/hr</span></div>
                      <small class="text-muted">Capacity: <strong><%= venue.capacity %></strong> pax</small>
                    </div>
                    <a href="/venues/<%= venue._id %>" class="btn btn-sm btn-outline-custom">
                      Details
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="col-12 text-center py-5">
            <p class="text-muted">No venues available yet. Please run the database seeder.</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-5 bg-white border-top border-bottom">
    <div class="container">
      <div class="text-center max-w-600 mx-auto mb-5">
        <span class="text-primary text-uppercase fw-bold small">Seamless Process</span>
        <h2 class="fw-bold text-dark">How Booking Works</h2>
        <p class="text-muted">Reserve your space in four straightforward steps with full transparency</p>
      </div>

      <div class="row g-4 text-center">
        <div class="col-md-3">
          <div class="p-4 rounded-4 bg-light h-100">
            <div class="stat-icon primary mx-auto mb-3">1</div>
            <h5 class="fw-bold text-dark mb-2">Discover</h5>
            <p class="text-muted small mb-0">Search campus venues by capacity, equipment, and required facilities.</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-4 rounded-4 bg-light h-100">
            <div class="stat-icon info mx-auto mb-3">2</div>
            <h5 class="fw-bold text-dark mb-2">Schedule</h5>
            <p class="text-muted small mb-0">Select your date and time with live conflict checking against maintenance & events.</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-4 rounded-4 bg-light h-100">
            <div class="stat-icon warning mx-auto mb-3">3</div>
            <h5 class="fw-bold text-dark mb-2">Admin Review</h5>
            <p class="text-muted small mb-0">Venue managers review your request with double-check conflict validation.</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-4 rounded-4 bg-light h-100">
            <div class="stat-icon success mx-auto mb-3">4</div>
            <h5 class="fw-bold text-dark mb-2">Host Event</h5>
            <p class="text-muted small mb-0">Receive instant confirmation and host your campus event with complete peace of mind.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
