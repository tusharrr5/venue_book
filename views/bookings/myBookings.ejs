<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container py-5">
    <%- include('../partials/flash') %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
      <div>
        <h1 class="fw-bold text-dark mb-1">My Booking Requests</h1>
        <p class="text-muted mb-0">Track reservation requests, active approvals, and event history.</p>
      </div>
      <div>
        <a href="/venues" class="btn btn-primary-custom d-flex align-items-center gap-2">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Find a Venue
        </a>
      </div>
    </div>

    <!-- Filter Tabs -->
    <div class="card card-custom border-0 shadow-sm mb-4">
      <div class="card-body p-2">
        <ul class="nav nav-pills flex-nowrap overflow-auto gap-2">
          <li class="nav-item">
            <a class="nav-link <%= currentStatusFilter === 'all' ? 'active' : '' %>" href="/bookings">
              All Bookings
            </a>
          </li>
          <% allStatuses.forEach(function(st) { %>
            <li class="nav-item">
              <a class="nav-link text-capitalize <%= currentStatusFilter === st ? 'active' : '' %>" href="/bookings?status=<%= st %>">
                <%= st %>
              </a>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>

    <!-- Bookings List -->
    <% if (bookings && bookings.length > 0) { %>
      <div class="card card-custom border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
          <table class="table table-custom mb-0">
            <thead>
              <tr>
                <th>Event & Venue</th>
                <th>Scheduled Date</th>
                <th>Time Slot</th>
                <th>Duration</th>
                <th>Total Tariff</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% bookings.forEach(function(b) { %>
                <tr>
                  <td>
                    <div class="fw-bold text-dark"><%= b.eventName %></div>
                    <small class="text-muted">🏛️ <%= b.venue ? b.venue.name : 'Unknown Venue' %></small>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= formatDateDisplay(b.bookingDate) %></div>
                    <small class="text-muted">Req: <%= formatDateDisplay(b.createdAt) %></small>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border">
                      <%= b.startTime %> – <%= b.endTime %>
                    </span>
                  </td>
                  <td><%= b.durationHours %> hrs</td>
                  <td class="fw-bold text-success"><%= formatCurrency(b.totalAmount) %></td>
                  <td>
                    <span class="badge badge-status badge-<%= b.status %>">
                      <%= b.status %>
                    </span>
                  </td>
                  <td class="text-end">
                    <div class="d-flex justify-content-end gap-2">
                      <a href="/bookings/<%= b._id %>" class="btn btn-sm btn-outline-custom">
                        Details
                      </a>
                      <% if (['pending', 'approved'].includes(b.status)) { %>
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-danger"
                          data-bs-toggle="modal"
                          data-bs-target="#cancelModal_<%= b._id %>"
                        >
                          Cancel
                        </button>
                      <% } %>
                    </div>

                    <!-- Individual Cancel Modal -->
                    <% if (['pending', 'approved'].includes(b.status)) { %>
                      <div class="modal fade text-start" id="cancelModal_<%= b._id %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content border-0 shadow">
                            <form action="/bookings/<%= b._id %>/cancel" method="POST">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <div class="modal-header border-bottom">
                                <h5 class="modal-title fw-bold text-dark">Cancel Booking</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                              </div>
                              <div class="modal-body p-4">
                                <p class="text-muted mb-3">
                                  Are you sure you want to cancel the booking for <strong>"<%= b.eventName %>"</strong> on <%= formatDateDisplay(b.bookingDate) %>?
                                </p>
                                <div class="mb-3">
                                  <label class="form-label fw-semibold small text-muted">Cancellation Reason</label>
                                  <textarea
                                    class="form-control"
                                    name="reason"
                                    rows="3"
                                    required
                                    placeholder="Why is this booking being cancelled?"
                                  ></textarea>
                                </div>
                              </div>
                              <div class="modal-footer border-top">
                                <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Close</button>
                                <button type="submit" class="btn btn-danger">Confirm Cancel</button>
                              </div>
                            </form>
                          </div>
                        </div>
                      </div>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="card card-custom p-5 text-center border-0 shadow-sm">
        <div class="stat-icon info mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.75rem;">
          📅
        </div>
        <h4 class="fw-bold text-dark">No Bookings Found</h4>
        <p class="text-muted mb-4">
          <%= currentStatusFilter !== 'all' ? `You have no ${currentStatusFilter} bookings.` : "You haven't submitted any venue booking requests yet." %>
        </p>
        <div>
          <a href="/venues" class="btn btn-primary-custom">Find and Book a Venue</a>
        </div>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
