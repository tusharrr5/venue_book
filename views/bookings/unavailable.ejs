<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container py-5">
    <!-- Unavailability Notice Banner -->
    <div class="card card-custom p-4 border-0 shadow-sm mb-4 border-start border-danger border-4">
      <div class="d-flex align-items-start gap-3">
        <div class="stat-icon danger flex-shrink-0" style="width: 52px; height: 52px; font-size: 1.5rem;">
          ⚠️
        </div>
        <div class="flex-grow-1">
          <h4 class="fw-bold text-dark mb-1">Requested Slot Is Unavailable</h4>
          <p class="text-danger fw-semibold mb-2">
            <%= conflictReason %>
          </p>
          <p class="text-muted small mb-0">
            You requested <strong><%= currentVenue ? currentVenue.name : 'Venue' %></strong> for <strong>"<%= requestDetails.eventName %>"</strong> on <strong><%= formatDateDisplay(requestDetails.bookingDate) %></strong> from <strong><%= requestDetails.startTime %> to <%= requestDetails.endTime %></strong> (<%= requestDetails.expectedAttendees %> attendees).
          </p>
        </div>
        <div>
          <a href="/bookings/new/<%= currentVenue._id %>" class="btn btn-outline-custom btn-sm">
            Modify Request
          </a>
        </div>
      </div>
    </div>

    <!-- Section 1: Alternative Venues for the same time slot -->
    <div class="mb-5">
      <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
          <span class="text-primary fw-bold small text-uppercase">Smart Recommendations</span>
          <h3 class="fw-bold text-dark mb-0">Available Alternative Venues</h3>
          <p class="text-muted small mb-0">Active venues that accommodate <%= requestDetails.expectedAttendees %> attendees and are free during <%= requestDetails.startTime %> – <%= requestDetails.endTime %></p>
        </div>
      </div>

      <% if (alternativeVenues && alternativeVenues.length > 0) { %>
        <div class="row g-4">
          <% alternativeVenues.forEach(function(alt) { %>
            <div class="col-md-6 col-lg-4">
              <div class="card card-custom h-100 d-flex flex-column border-0 shadow-sm">
                <img
                  src="<%= alt.imageUrl %>"
                  class="card-venue-img"
                  alt="<%= alt.name %>"
                  onerror="this.src='https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=800&q=80'"
                >
                <div class="card-body p-4 d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="fw-bold text-dark mb-0"><%= alt.name %></h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                      Available Slot
                    </span>
                  </div>
                  <p class="text-muted small mb-2">📍 <%= alt.location %></p>

                  <div class="d-flex flex-wrap gap-1 mb-3">
                    <% (alt.facilities || []).slice(0, 3).forEach(function(f) { %>
                      <span class="facility-pill"><%= f %></span>
                    <% }); %>
                    <% if (alt.facilities && alt.facilities.length > 3) { %>
                      <span class="facility-pill">+<%= alt.facilities.length - 3 %></span>
                    <% } %>
                  </div>

                  <div class="p-2 bg-light rounded-2 mb-3 small">
                    <div class="d-flex justify-content-between">
                      <span class="text-muted">Capacity:</span>
                      <strong><%= alt.capacity %> pax</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                      <span class="text-muted">Hourly Rate:</span>
                      <strong><%= formatCurrency(alt.hourlyRate) %>/hr</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                      <span class="text-muted">Est. Total:</span>
                      <strong class="text-success"><%= formatCurrency(alt.estimatedAmount) %></strong>
                    </div>
                  </div>

                  <div class="mt-auto">
                    <a
                      href="/bookings/new/<%= alt._id %>?date=<%= requestDetails.bookingDate %>&startTime=<%= requestDetails.startTime %>&endTime=<%= requestDetails.endTime %>"
                      class="btn btn-primary-custom w-100 btn-sm py-2"
                    >
                      Book This Venue Instead
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card card-custom p-4 text-center border-0 shadow-sm">
          <p class="text-muted mb-0">No alternative venues found matching your capacity and facility requirements for this exact time slot.</p>
        </div>
      <% } %>
    </div>

    <!-- Section 2: Alternative Time Slots for the SAME venue on that date -->
    <div>
      <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
          <span class="text-primary fw-bold small text-uppercase">Schedule Adjustment</span>
          <h3 class="fw-bold text-dark mb-0">Available Time Slots for <%= currentVenue ? currentVenue.name : 'This Venue' %></h3>
          <p class="text-muted small mb-0">Other clash-free slots available on <%= formatDateDisplay(requestDetails.bookingDate) %></p>
        </div>
      </div>

      <% if (alternativeSlots && alternativeSlots.length > 0) { %>
        <div class="row g-3">
          <% alternativeSlots.forEach(function(slot) { %>
            <div class="col-sm-6 col-md-3">
              <div class="card card-custom p-3 text-center border-0 shadow-sm h-100 d-flex flex-column justify-content-between">
                <div class="mb-2">
                  <span class="badge bg-light text-dark border px-3 py-1 mb-2">
                    <%= slot.durationHours %> hrs
                  </span>
                  <div class="fw-bold text-dark fs-5"><%= slot.startTime %> – <%= slot.endTime %></div>
                  <small class="text-success fw-semibold">✓ Verified Available</small>
                </div>
                <a
                  href="/bookings/new/<%= currentVenue._id %>?date=<%= requestDetails.bookingDate %>&startTime=<%= slot.startTime %>&endTime=<%= slot.endTime %>"
                  class="btn btn-outline-custom btn-sm w-100"
                >
                  Select Slot
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card card-custom p-4 text-center border-0 shadow-sm">
          <p class="text-muted mb-0">No alternative time slots available on this date. Please consider selecting another date.</p>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
