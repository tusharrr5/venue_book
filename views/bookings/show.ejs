<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container py-5">
    <%- include('../partials/flash') %>

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Home</a></li>
        <li class="breadcrumb-item"><a href="<%= isAdmin ? '/admin/bookings' : '/bookings' %>" class="text-decoration-none text-muted"><%= isAdmin ? 'All Bookings' : 'My Bookings' %></a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= booking.eventName %></li>
      </ol>
    </nav>

    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card card-custom p-4 p-md-5 border-0 shadow-sm mb-4">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
              <span class="text-muted small text-uppercase fw-semibold">Booking Reference #<%= booking._id.toString().slice(-6) %></span>
              <h2 class="fw-bold text-dark mb-1"><%= booking.eventName %></h2>
              <p class="text-muted mb-0">Requested by: <strong><%= booking.organiser.name %></strong> (<%= booking.organiser.email %>)</p>
            </div>
            <span class="badge badge-status badge-<%= booking.status %> fs-6 px-3 py-2">
              <%= booking.status %>
            </span>
          </div>

          <hr class="my-4">

          <h5 class="fw-bold text-dark mb-3">Event Details</h5>
          <p class="text-muted mb-4" style="line-height: 1.7;">
            <%= booking.eventDescription %>
          </p>

          <div class="row g-3 mb-4">
            <div class="col-sm-6 col-md-4">
              <div class="p-3 bg-light rounded-3">
                <span class="text-muted small d-block">Scheduled Date</span>
                <span class="fw-bold text-dark"><%= formatDateDisplay(booking.bookingDate) %></span>
              </div>
            </div>
            <div class="col-sm-6 col-md-4">
              <div class="p-3 bg-light rounded-3">
                <span class="text-muted small d-block">Time Slot</span>
                <span class="fw-bold text-dark"><%= booking.startTime %> – <%= booking.endTime %></span>
              </div>
            </div>
            <div class="col-sm-6 col-md-4">
              <div class="p-3 bg-light rounded-3">
                <span class="text-muted small d-block">Duration</span>
                <span class="fw-bold text-dark"><%= booking.durationHours %> hours</span>
              </div>
            </div>
            <div class="col-sm-6 col-md-4">
              <div class="p-3 bg-light rounded-3">
                <span class="text-muted small d-block">Expected Attendees</span>
                <span class="fw-bold text-dark"><%= booking.expectedAttendees %> pax</span>
              </div>
            </div>
            <div class="col-sm-6 col-md-4">
              <div class="p-3 bg-light rounded-3">
                <span class="text-muted small d-block">Calculated Amount</span>
                <span class="fw-bold text-success fs-5"><%= formatCurrency(booking.totalAmount) %></span>
              </div>
            </div>
            <div class="col-sm-6 col-md-4">
              <div class="p-3 bg-light rounded-3">
                <span class="text-muted small d-block">Request Date</span>
                <span class="fw-bold text-dark"><%= formatDateDisplay(booking.createdAt) %></span>
              </div>
            </div>
          </div>

          <!-- Admin Remarks if any -->
          <% if (booking.adminRemarks) { %>
            <div class="alert alert-info border-0 mb-4">
              <div class="fw-bold mb-1">Administrative Remarks:</div>
              <div><%= booking.adminRemarks %></div>
            </div>
          <% } %>

          <!-- Cancellation info if cancelled -->
          <% if (booking.status === 'cancelled') { %>
            <div class="alert alert-secondary border-0 mb-4">
              <div class="fw-bold mb-1">Booking Cancellation:</div>
              <div><strong>Reason:</strong> <%= booking.cancellationReason || 'No reason provided' %></div>
              <div class="small text-muted mt-1">Cancelled on <%= formatDateDisplay(booking.cancelledAt) %></div>
            </div>
          <% } %>

          <!-- Approval info if approved -->
          <% if (booking.approvedAt) { %>
            <div class="p-3 bg-light rounded-3 mb-4 small text-muted">
              <div>Approved by <strong><%= booking.approvedBy ? booking.approvedBy.name : 'Administrator' %></strong> on <%= formatDateDisplay(booking.approvedAt) %></div>
            </div>
          <% } %>

          <!-- Actions -->
          <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-3 border-top">
            <a href="<%= isAdmin ? '/admin/bookings' : '/bookings' %>" class="btn btn-outline-custom">
              &larr; Back to <%= isAdmin ? 'All Requests' : 'My Bookings' %>
            </a>

            <% if (['pending', 'approved'].includes(booking.status)) { %>
              <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                Cancel Booking
              </button>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Venue Summary Card -->
      <div class="col-lg-4">
        <div class="card card-custom p-4 border-0 shadow-sm">
          <h5 class="fw-bold text-dark mb-3">Venue Overview</h5>
          <img
            src="<%= booking.venue.imageUrl %>"
            class="rounded-3 mb-3 w-100"
            alt="<%= booking.venue.name %>"
            style="height: 180px; object-fit: cover;"
            onerror="this.src='https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=800&q=80'"
          >
          <h6 class="fw-bold text-dark mb-1"><%= booking.venue.name %></h6>
          <p class="text-muted small mb-3">📍 <%= booking.venue.location %></p>

          <div class="border-top pt-3">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted small">Max Capacity:</span>
              <span class="fw-bold text-dark small"><%= booking.venue.capacity %> attendees</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted small">Hourly Rate:</span>
              <span class="fw-bold text-primary small"><%= formatCurrency(booking.venue.hourlyRate) %>/hr</span>
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-muted small">Venue Status:</span>
              <span class="badge badge-status <%= booking.venue.status === 'active' ? 'badge-active' : 'badge-inactive' %>">
                <%= booking.venue.status %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Cancellation Modal -->
  <% if (['pending', 'approved'].includes(booking.status)) { %>
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
          <form action="/bookings/<%= booking._id %>/cancel" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header border-bottom">
              <h5 class="modal-title fw-bold text-dark" id="cancelModalLabel">Cancel Booking</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
              <p class="text-muted mb-3">
                Are you sure you want to cancel the booking for <strong>"<%= booking.eventName %>"</strong>? This will release the venue slot for other organizers.
              </p>
              <div class="mb-3">
                <label for="reason" class="form-label fw-semibold small text-muted">Reason for Cancellation</label>
                <textarea
                  class="form-control"
                  id="reason"
                  name="reason"
                  rows="3"
                  required
                  placeholder="Please specify why this booking is being cancelled..."
                ></textarea>
              </div>
            </div>
            <div class="modal-footer border-top">
              <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Keep Booking</button>
              <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } %>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
