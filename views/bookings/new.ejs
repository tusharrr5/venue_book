<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container py-5">
    <%- include('../partials/flash') %>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a href="/venues" class="text-decoration-none text-muted">Venues</a></li>
            <li class="breadcrumb-item"><a href="/venues/<%= venue._id %>" class="text-decoration-none text-muted"><%= venue.name %></a></li>
            <li class="breadcrumb-item active" aria-current="page">Book Venue</li>
          </ol>
        </nav>

        <div class="card card-custom p-4 p-md-5 border-0 shadow-sm">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 border-bottom pb-3">
            <div>
              <h2 class="fw-bold text-dark mb-1">Request Venue Booking</h2>
              <p class="text-muted small mb-0">Fill out your event details to submit a reservation request for administrative approval.</p>
            </div>
            <div class="text-md-end">
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-2">
                <%= venue.name %>
              </span>
            </div>
          </div>

          <form action="/bookings" method="POST" id="bookingForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="venueId" value="<%= venue._id %>">
            <input type="hidden" id="hourlyRate" value="<%= venue.hourlyRate %>">

            <!-- Venue Summary Card -->
            <div class="p-3 bg-light rounded-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
              <div>
                <span class="text-muted small d-block">Location</span>
                <span class="fw-semibold text-dark">📍 <%= venue.location %></span>
              </div>
              <div>
                <span class="text-muted small d-block">Capacity Limit</span>
                <span class="fw-semibold text-dark">👥 Max <%= venue.capacity %> attendees</span>
              </div>
              <div>
                <span class="text-muted small d-block">Hourly Tariff</span>
                <span class="fw-semibold text-primary"><%= formatCurrency(venue.hourlyRate) %>/hr</span>
              </div>
            </div>

            <!-- Event Details -->
            <div class="mb-3">
              <label for="eventName" class="form-label fw-semibold small text-muted">Event Name</label>
              <input
                type="text"
                class="form-control"
                id="eventName"
                name="eventName"
                value="<%= oldInput.eventName || '' %>"
                required
                placeholder="e.g. Annual Campus Hackathon 2026"
                maxlength="150"
              >
            </div>

            <div class="mb-3">
              <label for="eventDescription" class="form-label fw-semibold small text-muted">Event Description & Objective</label>
              <textarea
                class="form-control"
                id="eventDescription"
                name="eventDescription"
                rows="3"
                required
                placeholder="Describe your event, agenda, and requirements..."
              ><%= oldInput.eventDescription || '' %></textarea>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label for="expectedAttendees" class="form-label fw-semibold small text-muted">
                  Expected Attendees (Max: <%= venue.capacity %>)
                </label>
                <input
                  type="number"
                  class="form-control"
                  id="expectedAttendees"
                  name="expectedAttendees"
                  value="<%= oldInput.expectedAttendees || '' %>"
                  required
                  min="1"
                  max="<%= venue.capacity %>"
                  placeholder="e.g. 120"
                >
              </div>

              <div class="col-md-6">
                <label for="bookingDate" class="form-label fw-semibold small text-muted">Event Date</label>
                <input
                  type="date"
                  class="form-control"
                  id="bookingDate"
                  name="bookingDate"
                  value="<%= oldInput.bookingDate || prefillDate %>"
                  required
                  min="<%= todayDate %>"
                >
              </div>
            </div>

            <!-- Time Slots -->
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="startTime" class="form-label fw-semibold small text-muted">Start Time (24h)</label>
                <input
                  type="time"
                  class="form-control"
                  id="startTime"
                  name="startTime"
                  value="<%= oldInput.startTime || prefillStart %>"
                  required
                  step="900"
                >
                <small class="text-muted">Standard hours: 08:00 to 22:00</small>
              </div>

              <div class="col-md-6">
                <label for="endTime" class="form-label fw-semibold small text-muted">End Time (24h)</label>
                <input
                  type="time"
                  class="form-control"
                  id="endTime"
                  name="endTime"
                  value="<%= oldInput.endTime || prefillEnd %>"
                  required
                  step="900"
                >
                <small class="text-muted">Must be later than start time</small>
              </div>
            </div>

            <!-- Estimated Calculation Box -->
            <div class="p-3 rounded-3 border mb-4 bg-white shadow-sm">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small">Estimated Duration:</span>
                <span class="fw-bold text-dark" id="durationDisplay">2.0 hrs</span>
              </div>
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">Estimated Total Amount:</span>
                <span class="fw-bold text-success fs-5" id="amountDisplay">₹0</span>
              </div>
              <div class="text-muted mt-2 small" style="font-size: 0.78rem;">
                * Calculated as Duration × Hourly Rate. Final amount is verified and confirmed server-side upon booking creation.
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
              <a href="/venues/<%= venue._id %>" class="btn btn-outline-custom">Cancel</a>
              <button type="submit" class="btn btn-primary-custom px-4 py-2">
                Submit Booking Request
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/bookingForm.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
