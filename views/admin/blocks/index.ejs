<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100 admin-theme">
  <%- include('../../partials/navbar') %>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <div class="col-lg-2 p-0 d-none d-lg-block">
        <%- include('../../partials/adminSidebar') %>
      </div>

      <div class="col-lg-10 p-4 p-md-5 admin-content">
        <%- include('../../partials/flash') %>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 animate-fade-in-up">
          <div>
            <h1 class="fw-bold mb-1" style="font-size: 1.75rem;">Venue Maintenance Blocks</h1>
            <p class="mb-0" style="color: var(--admin-text-muted);">Schedule downtime, repairs, renovations, or administrative blackouts across campus venues.</p>
          </div>
          <div>
            <button type="button" class="btn btn-primary-custom d-flex align-items-center gap-2 hover-lift" data-bs-toggle="modal" data-bs-target="#newBlockModal">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Schedule Maintenance Block
            </button>
          </div>
        </div>

        <!-- Blocks Table -->
        <div class="card card-custom border-0 shadow-sm overflow-hidden animate-fade-in-up" style="animation-delay: 0.1s;">
          <% if (blocks && blocks.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-custom mb-0">
                <thead>
                  <tr>
                    <th>Venue</th>
                    <th>Date</th>
                    <th>Time Interval</th>
                    <th>Reason</th>
                    <th>Scheduled By</th>
                    <th class="text-end">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% blocks.forEach(function(b) { %>
                    <tr>
                      <td>
                        <div class="fw-bold"><%= b.venue ? b.venue.name : 'Unknown Venue' %></div>
                        <small style="color: var(--admin-text-muted);">📍 <%= b.venue ? b.venue.location : '' %></small>
                      </td>
                      <td>
                        <strong style="color: var(--admin-text);"><%= formatDateDisplay(b.date) %></strong>
                      </td>
                      <td>
                        <span class="badge rounded-pill fw-medium" style="background: rgba(245,158,11,0.15); color: #fcd34d; border: 1px solid rgba(245,158,11,0.3);">
                          <%= b.startTime %> – <%= b.endTime %>
                        </span>
                      </td>
                      <td>
                        <span class="badge" style="background: rgba(255,255,255,0.06); color: var(--admin-text-secondary); border: 1px solid rgba(255,255,255,0.1);"><%= b.reason %></span>
                      </td>
                      <td>
                        <small style="color: var(--admin-text-muted);"><%= b.createdBy ? b.createdBy.name : 'Admin' %></small>
                      </td>
                      <td class="text-end">
                        <form action="/admin/blocks/<%= b._id %>?_method=DELETE" method="POST" class="d-inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-sm btn-outline-danger px-3 hover-lift" style="background: transparent; border-color: rgba(239,68,68,0.3); color: #fca5a5;" onclick="return confirm('Remove this maintenance block and restore venue availability?')">
                            Remove
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-state-icon" style="background: rgba(16,185,129,0.15); color: #6ee7b7;">🛠️</div>
              <h5 class="fw-bold mb-1">No Active Maintenance Blocks</h5>
              <p class="small mb-0" style="color: var(--admin-text-muted);">All venues are currently operating on their standard availability schedules.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- New Maintenance Block Modal -->
  <div class="modal fade" id="newBlockModal" tabindex="-1" aria-labelledby="newBlockModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg" style="background: var(--admin-bg); border: 1px solid var(--admin-border);">
        <form action="/admin/blocks" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="modal-header border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
            <h5 class="modal-title fw-bold text-white" id="newBlockModalLabel">Schedule Maintenance Block</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <div class="mb-4">
              <label for="venue" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--admin-text-muted);">Target Venue</label>
              <select class="form-select form-select-lg" id="venue" name="venue" required>
                <option value="">Select a venue...</option>
                <% venues.forEach(function(v) { %>
                  <option value="<%= v._id %>"><%= v.name %></option>
                <% }); %>
              select>
            </div>

            <div class="mb-4">
              <label for="date" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--admin-text-muted);">Block Date</label>
              <input
                type="date"
                class="form-control form-control-lg"
                id="date"
                name="date"
                required
                min="<%= todayDate %>"
                value="<%= todayDate %>"
              >
            </div>

            <div class="row g-3 mb-4">
              <div class="col-6">
                <label for="startTime" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--admin-text-muted);">Start Time</label>
                <input type="time" class="form-control form-control-lg" id="startTime" name="startTime" required value="08:00">
              </div>
              <div class="col-6">
                <label for="endTime" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--admin-text-muted);">End Time</label>
                <input type="time" class="form-control form-control-lg" id="endTime" name="endTime" required value="14:00">
              </div>
            </div>

            <div class="mb-4">
              <label for="reason" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--admin-text-muted);">Reason / Category</label>
              <select class="form-select form-select-lg" id="reason" name="reason" required>
                <% blockReasons.forEach(function(r) { %>
                  <option value="<%= r %>"><%= r %></option>
                <% }); %>
              </select>
            </div>

            <div class="alert border-0 small mb-0 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06) !important; color: var(--admin-text-secondary);">
              * Note: If any approved or pending bookings conflict with this scheduled block, a warning notification will be recorded in the system.
            </div>
          </div>
          <div class="modal-footer border-top" style="border-color: rgba(255,255,255,0.1) !important;">
            <button type="button" class="btn btn-outline-custom px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary-custom px-4 hover-lift">Create Block</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <%- include('../../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
