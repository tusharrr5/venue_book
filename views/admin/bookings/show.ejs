<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100 admin-theme">
  <%- include('../../partials/navbar') %>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <div class="col-lg-2 p-0 d-none d-lg-block">
        <%- include('../../partials/adminSidebar') %>
      </div>

      <div class="col-lg-10 p-4 p-md-5 admin-content">
        <%- include('../../partials/flash') %>

        <nav aria-label="breadcrumb" class="mb-4 animate-fade-in">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin/dashboard" class="text-decoration-none hover-lift" style="color: var(--admin-text-muted);">Admin</a></li>
            <li class="breadcrumb-item"><a href="/admin/bookings" class="text-decoration-none hover-lift" style="color: var(--admin-text-muted);">Bookings</a></li>
            <li class="breadcrumb-item active fw-medium" aria-current="page"><%= booking.eventName %></li>
          </ol>
        </nav>

        <!-- Conflict Alert if any -->
        <% if (conflicts && conflicts.length > 0) { %>
          <div class="alert alert-danger d-flex align-items-center gap-3 p-3 shadow-sm mb-4 animate-fade-in-up" style="background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5;">
            <div class="fs-3">⚠️</div>
            <div>
              <div class="fw-bold fs-6 text-white">Schedule Conflict Detected!</div>
              <div><%= conflicts.join('. ') %></div>
              <small style="color: rgba(252,165,165,0.8);">Approving this booking while an overlapping booking or maintenance block is active will be blocked.</small>
            </div>
          </div>
        <% } %>

        <div class="row g-4 stagger-children">
          <div class="col-lg-8">
            <div class="card card-custom p-4 p-md-5 border-0 shadow-sm mb-4">
              <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                  <span class="small text-uppercase fw-semibold" style="color: var(--admin-text-muted); letter-spacing: 0.05em;">Booking ID: <%= booking._id %></span>
                  <h2 class="fw-bold mb-1" style="color: var(--admin-text);"><%= booking.eventName %></h2>
                  <p class="mb-0" style="color: var(--admin-text-muted);">Organiser: <strong style="color: var(--admin-text-secondary);"><%= booking.organiser.name %></strong> (<%= booking.organiser.email %>)</p>
                </div>
                <span class="badge badge-status badge-<%= booking.status %> fs-6 px-4 py-2 mt-2 mt-sm-0">
                  <%= booking.status %>
                </span>
              </div>

              <div class="divider"></div>

              <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <svg width="20" height="20" fill="none" stroke="var(--color-primary)" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Event Description
              </h5>
              <p class="mb-4" style="line-height: 1.7; color: var(--admin-text-secondary); font-size: 1.05rem;">
                <%= booking.eventDescription %>
              </p>

              <div class="row g-3 mb-4">
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                    <span class="small d-block mb-1" style="color: var(--admin-text-muted);">Scheduled Date</span>
                    <span class="fw-bold fs-6"><%= formatDateDisplay(booking.bookingDate) %></span>
                  </div>
                </div>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                    <span class="small d-block mb-1" style="color: var(--admin-text-muted);">Time Slot</span>
                    <span class="badge rounded-pill fw-medium" style="background: rgba(99,102,241,0.15); color: #a5b4fc;"><%= booking.startTime %> – <%= booking.endTime %></span>
                  </div>
                </div>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                    <span class="small d-block mb-1" style="color: var(--admin-text-muted);">Duration</span>
                    <span class="fw-bold"><%= booking.durationHours %> hours</span>
                  </div>
                </div>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                    <span class="small d-block mb-1" style="color: var(--admin-text-muted);">Expected Attendance</span>
                    <span class="fw-bold"><%= booking.expectedAttendees %> pax</span>
                  </div>
                </div>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                    <span class="small d-block mb-1" style="color: var(--admin-text-muted);">Total Tariff</span>
                    <span class="fw-bold fs-5" style="color: #4ade80;"><%= formatCurrency(booking.totalAmount) %></span>
                  </div>
                </div>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                    <span class="small d-block mb-1" style="color: var(--admin-text-muted);">Submitted On</span>
                    <span class="fw-bold"><%= formatDateDisplay(booking.createdAt) %></span>
                  </div>
                </div>
              </div>

              <% if (booking.adminRemarks) { %>
                <div class="alert alert-info border-0 mb-4" style="background: rgba(6,182,212,0.1); color: #67e8f9;">
                  <div class="fw-bold mb-1">Administrative Remarks:</div>
                  <div><%= booking.adminRemarks %></div>
                </div>
              <% } %>

              <% if (booking.status === 'cancelled') { %>
                <div class="alert alert-secondary border-0 mb-4" style="background: rgba(255,255,255,0.05); color: #cbd5e1;">
                  <div class="fw-bold mb-1">Cancellation Record:</div>
                  <div><%= booking.cancellationReason || 'No reason specified' %></div>
                  <div class="small mt-1" style="color: var(--admin-text-muted);">Cancelled on <%= formatDateDisplay(booking.cancelledAt) %></div>
                </div>
              <% } %>

              <% if (booking.approvedAt) { %>
                <div class="p-3 rounded-3 mb-4 small" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); color: var(--admin-text-secondary);">
                  Approved by <strong class="text-white"><%= booking.approvedBy ? booking.approvedBy.name : 'Admin' %></strong> on <%= formatDateDisplay(booking.approvedAt) %>
                </div>
              <% } %>

              <% if (booking.completedAt) { %>
                <div class="p-3 rounded-3 mb-4 small fw-semibold" style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.2); color: #6ee7b7;">
                  ✓ Event marked as completed on <%= formatDateDisplay(booking.completedAt) %>
                </div>
              <% } %>

              <!-- Action Controls -->
              <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center pt-4 mt-2 border-top">
                <a href="/admin/bookings" class="btn btn-outline-custom px-4">
                  &larr; Back to Requests
                </a>

                <div class="d-flex flex-wrap gap-2">
                  <!-- Pending Actions -->
                  <% if (booking.status === 'pending') { %>
                    <button type="button" class="btn btn-outline-danger px-4" data-bs-toggle="modal" data-bs-target="#rejectModal" style="background: transparent; border-color: rgba(239,68,68,0.3); color: #fca5a5;">
                      Reject
                    </button>

                    <form action="/admin/bookings/<%= booking._id %>/approve" method="POST" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-success fw-bold px-4 hover-lift" style="background: linear-gradient(135deg, #10b981, #059669); border: none;">
                        Approve Booking
                      </button>
                    </form>
                  <% } %>

                  <!-- Approved Actions -->
                  <% if (booking.status === 'approved') { %>
                    <button type="button" class="btn btn-outline-danger px-4" data-bs-toggle="modal" data-bs-target="#cancelModal" style="background: transparent; border-color: rgba(239,68,68,0.3); color: #fca5a5;">
                      Cancel
                    </button>

                    <form action="/admin/bookings/<%= booking._id %>/complete" method="POST" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-primary-custom px-4 hover-lift">
                        Mark Completed
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <!-- Venue Card Sidebar -->
          <div class="col-lg-4">
            <div class="card card-custom p-4 border-0 shadow-sm sticky-top" style="top: 90px;">
              <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <svg width="20" height="20" fill="none" stroke="var(--color-primary)" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                Venue Information
              </h5>
              
              <div class="position-relative mb-3 rounded-3 overflow-hidden">
                <img
                  src="<%= booking.venue.imageUrl %>"
                  class="w-100"
                  alt="<%= booking.venue.name %>"
                  style="height: 180px; object-fit: cover; transition: transform 0.5s ease;"
                  onerror="this.src='https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=800&q=80'"
                >
                <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);">
                  <h5 class="fw-bold text-white mb-0"><%= booking.venue.name %></h5>
                </div>
              </div>
              
              <p class="small mb-3 d-flex align-items-center gap-1" style="color: var(--admin-text-secondary);">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <%= booking.venue.location %>
              </p>

              <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                  <span class="small" style="color: var(--admin-text-muted);">Max Capacity:</span>
                  <span class="fw-bold small"><%= booking.venue.capacity %> pax</span>
                </div>
                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                  <span class="small" style="color: var(--admin-text-muted);">Hourly Tariff:</span>
                  <span class="fw-bold small" style="color: #818cf8;"><%= formatCurrency(booking.venue.hourlyRate) %>/hr</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                  <span class="small" style="color: var(--admin-text-muted);">Status:</span>
                  <span class="badge badge-status <%= booking.venue.status === 'active' ? 'badge-active' : 'badge-inactive' %>">
                    <%= booking.venue.status %>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Reject Modal -->
  <% if (booking.status === 'pending') { %>
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="background: var(--admin-bg); border: 1px solid var(--admin-border);">
          <form action="/admin/bookings/<%= booking._id %>/reject" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header border-bottom">
              <h5 class="modal-title fw-bold text-white">Reject Booking Request</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
              <p class="mb-3" style="color: var(--admin-text-secondary);">
                Are you sure you want to reject the booking request for <strong class="text-white">"<%= booking.eventName %>"</strong>?
              </p>
              <div class="mb-3">
                <label for="remarks" class="form-label fw-semibold small" style="color: var(--admin-text-muted);">Administrative Remarks / Reason</label>
                <textarea
                  class="form-control"
                  id="remarks"
                  name="remarks"
                  rows="3"
                  required
                  placeholder="Provide reasons for rejection..."
                ></textarea>
              </div>
            </div>
            <div class="modal-footer border-top">
              <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-danger hover-lift" style="background: linear-gradient(135deg, #ef4444, #dc2626); border: none;">Confirm Rejection</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Cancel Modal -->
  <% if (booking.status === 'approved') { %>
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="background: var(--admin-bg); border: 1px solid var(--admin-border);">
          <form action="/bookings/<%= booking._id %>/cancel" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header border-bottom">
              <h5 class="modal-title fw-bold text-white">Cancel Approved Booking</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
              <p class="mb-3" style="color: var(--admin-text-secondary);">
                Cancel the approved reservation for <strong class="text-white">"<%= booking.eventName %>"</strong>?
              </p>
              <div class="mb-3">
                <label class="form-label fw-semibold small" style="color: var(--admin-text-muted);">Cancellation Reason</label>
                <textarea class="form-control" name="reason" rows="3" required placeholder="Specify reason..."></textarea>
              </div>
            </div>
            <div class="modal-footer border-top">
              <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Keep Booking</button>
              <button type="submit" class="btn btn-danger hover-lift" style="background: linear-gradient(135deg, #ef4444, #dc2626); border: none;">Confirm Cancel</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } %>

  <%- include('../../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
