<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../../partials/navbar') %>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <div class="col-lg-2 p-0 d-none d-lg-block">
        <%- include('../../partials/adminSidebar') %>
      </div>

      <div class="col-lg-10 p-4 p-md-5">
        <%- include('../../partials/flash') %>

        <nav aria-label="breadcrumb" class="mb-4">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin/dashboard" class="text-decoration-none text-muted">Admin</a></li>
            <li class="breadcrumb-item"><a href="/admin/bookings" class="text-decoration-none text-muted">Bookings</a></li>
            <li class="breadcrumb-item active" aria-current="page"><%= booking.eventName %></li>
          </ol>
        </nav>

        <!-- Conflict Alert if any -->
        <% if (conflicts && conflicts.length > 0) { %>
          <div class="alert alert-danger d-flex align-items-center gap-3 p-3 shadow-sm mb-4">
            <div class="fs-3">⚠️</div>
            <div>
              <div class="fw-bold fs-6">Schedule Conflict Detected!</div>
              <div><%= conflicts.join('. ') %></div>
              <small class="text-muted">Approving this booking while an overlapping booking or maintenance block is active will be blocked.</small>
            </div>
          </div>
        <% } %>

        <div class="row g-4">
          <div class="col-lg-8">
            <div class="card card-custom p-4 p-md-5 border-0 shadow-sm mb-4">
              <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                  <span class="text-muted small text-uppercase fw-semibold">Booking ID: <%= booking._id %></span>
                  <h2 class="fw-bold text-dark mb-1"><%= booking.eventName %></h2>
                  <p class="text-muted mb-0">Organiser: <strong><%= booking.organiser.name %></strong> (<%= booking.organiser.email %>)</p>
                </div>
                <span class="badge badge-status badge-<%= booking.status %> fs-6 px-3 py-2">
                  <%= booking.status %>
                </span>
              </div>

              <hr class="my-4">

              <h5 class="fw-bold text-dark mb-2">Event Description</h5>
              <p class="text-muted mb-4" style="line-height: 1.7;">
                <%= booking.eventDescription %>
              </p>

              <div class="row g-3 mb-4">
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 bg-light rounded-3">
                    <span class="text-muted small d-block">Scheduled Date</span>
                    <span class="fw-bold text-dark"><%= formatDateDisplay(booking.bookingDate) %></span>
                  </div>
                </div>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 bg-light rounded-3">
                    <span class="text-muted small d-block">Time Slot</span>
                    <span class="fw-bold text-dark"><%= booking.startTime %> – <%= booking.endTime %></span>
                  </div>
                </div>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 bg-light rounded-3">
                    <span class="text-muted small d-block">Duration</span>
                    <span class="fw-bold text-dark"><%= booking.durationHours %> hours</span>
                  </div>
                </div>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 bg-light rounded-3">
                    <span class="text-muted small d-block">Expected Attendance</span>
                    <span class="fw-bold text-dark"><%= booking.expectedAttendees %> attendees</span>
                  </div>
                </div>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 bg-light rounded-3">
                    <span class="text-muted small d-block">Total Tariff</span>
                    <span class="fw-bold text-success fs-5"><%= formatCurrency(booking.totalAmount) %></span>
                  </div>
                </div>
                <div class="col-sm-6 col-md-4">
                  <div class="p-3 bg-light rounded-3">
                    <span class="text-muted small d-block">Submitted On</span>
                    <span class="fw-bold text-dark"><%= formatDateDisplay(booking.createdAt) %></span>
                  </div>
                </div>
              </div>

              <% if (booking.adminRemarks) { %>
                <div class="alert alert-info border-0 mb-4">
                  <div class="fw-bold mb-1">Administrative Remarks:</div>
                  <div><%= booking.adminRemarks %></div>
                </div>
              <% } %>

              <% if (booking.status === 'cancelled') { %>
                <div class="alert alert-secondary border-0 mb-4">
                  <div class="fw-bold mb-1">Cancellation Record:</div>
                  <div><%= booking.cancellationReason || 'No reason specified' %></div>
                  <div class="small text-muted mt-1">Cancelled on <%= formatDateDisplay(booking.cancelledAt) %></div>
                </div>
              <% } %>

              <% if (booking.approvedAt) { %>
                <div class="p-3 bg-light rounded-3 mb-4 small text-muted">
                  Approved by <strong><%= booking.approvedBy ? booking.approvedBy.name : 'Admin' %></strong> on <%= formatDateDisplay(booking.approvedAt) %>
                </div>
              <% } %>

              <% if (booking.completedAt) { %>
                <div class="p-3 bg-light rounded-3 mb-4 small text-success fw-semibold">
                  ✓ Event marked as completed on <%= formatDateDisplay(booking.completedAt) %>
                </div>
              <% } %>

              <!-- Action Controls -->
              <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-3 border-top">
                <a href="/admin/bookings" class="btn btn-outline-custom">
                  &larr; Back to Requests
                </a>

                <div class="d-flex gap-2">
                  <!-- Pending Actions -->
                  <% if (booking.status === 'pending') { %>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                      Reject Request
                    </button>

                    <form action="/admin/bookings/<%= booking._id %>/approve" method="POST" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-success fw-bold px-4">
                        Approve Booking
                      </button>
                    </form>
                  <% } %>

                  <!-- Approved Actions -->
                  <% if (booking.status === 'approved') { %>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                      Cancel Booking
                    </button>

                    <form action="/admin/bookings/<%= booking._id %>/complete" method="POST" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-primary-custom px-4">
                        Mark Event Completed
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <!-- Venue Card Sidebar -->
          <div class="col-lg-4">
            <div class="card card-custom p-4 border-0 shadow-sm">
              <h5 class="fw-bold text-dark mb-3">Venue Information</h5>
              <img
                src="<%= booking.venue.imageUrl %>"
                class="rounded-3 mb-3 w-100"
                alt="<%= booking.venue.name %>"
                style="height: 180px; object-fit: cover;"
                onerror="this.src='https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=800&q=80'"
              >
              <h5 class="fw-bold text-dark mb-1"><%= booking.venue.name %></h5>
              <p class="text-muted small mb-3">📍 <%= booking.venue.location %></p>

              <div class="border-top pt-3">
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted small">Max Capacity:</span>
                  <span class="fw-bold text-dark small"><%= booking.venue.capacity %> attendees</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted small">Hourly Tariff:</span>
                  <span class="fw-bold text-primary small"><%= formatCurrency(booking.venue.hourlyRate) %>/hr</span>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="text-muted small">Status:</span>
                  <span class="badge badge-status <%= booking.venue.status === 'active' ? 'badge-active' : 'badge-inactive' %>">
                    <%= booking.venue.status %>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Reject Modal -->
  <% if (booking.status === 'pending') { %>
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
          <form action="/admin/bookings/<%= booking._id %>/reject" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header border-bottom">
              <h5 class="modal-title fw-bold text-dark">Reject Booking Request</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
              <p class="text-muted mb-3">
                Are you sure you want to reject the booking request for <strong>"<%= booking.eventName %>"</strong>?
              </p>
              <div class="mb-3">
                <label for="remarks" class="form-label fw-semibold small text-muted">Administrative Remarks / Reason</label>
                <textarea
                  class="form-control"
                  id="remarks"
                  name="remarks"
                  rows="3"
                  required
                  placeholder="Provide reasons for rejection (e.g. facility unavailable, prioritised campus event)..."
                ></textarea>
              </div>
            </div>
            <div class="modal-footer border-top">
              <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-danger">Confirm Rejection</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Cancel Modal -->
  <% if (booking.status === 'approved') { %>
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
          <form action="/bookings/<%= booking._id %>/cancel" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header border-bottom">
              <h5 class="modal-title fw-bold text-dark">Cancel Approved Booking</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
              <p class="text-muted mb-3">
                Cancel the approved reservation for <strong>"<%= booking.eventName %>"</strong>?
              </p>
              <div class="mb-3">
                <label class="form-label fw-semibold small text-muted">Cancellation Reason</label>
                <textarea class="form-control" name="reason" rows="3" required placeholder="Specify reason..."></textarea>
              </div>
            </div>
            <div class="modal-footer border-top">
              <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Keep Booking</button>
              <button type="submit" class="btn btn-danger">Confirm Cancel</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } %>

  <%- include('../../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
