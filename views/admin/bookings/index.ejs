<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../../partials/navbar') %>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <div class="col-lg-2 p-0 d-none d-lg-block">
        <%- include('../../partials/adminSidebar') %>
      </div>

      <div class="col-lg-10 p-4 p-md-5">
        <%- include('../../partials/flash') %>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
          <div>
            <h1 class="fw-bold text-dark mb-1">Booking Requests & Approvals</h1>
            <p class="text-muted mb-0">Review event proposals, approve requests, monitor clash status, and mark events completed.</p>
          </div>
        </div>

        <!-- Filter Bar -->
        <div class="card card-custom p-3 border-0 shadow-sm mb-4">
          <form action="/admin/bookings" method="GET" class="row g-3 align-items-center">
            <div class="col-md-3">
              <label class="form-label small fw-semibold text-muted mb-1">Status Filter</label>
              <select class="form-select form-select-sm" name="status" onchange="this.form.submit()">
                <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
                <% allStatuses.forEach(function(st) { %>
                  <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %> class="text-capitalize"><%= st %></option>
                <% }); %>
              </select>
            </div>

            <div class="col-md-4">
              <label class="form-label small fw-semibold text-muted mb-1">Venue Filter</label>
              <select class="form-select form-select-sm" name="venueId" onchange="this.form.submit()">
                <option value="">All Venues</option>
                <% venues.forEach(function(v) { %>
                  <option value="<%= v._id %>" <%= filters.venueId === v._id.toString() ? 'selected' : '' %>><%= v.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="col-md-3">
              <label class="form-label small fw-semibold text-muted mb-1">Event Date</label>
              <input type="date" class="form-control form-control-sm" name="date" value="<%= filters.date %>" onchange="this.form.submit()">
            </div>

            <div class="col-md-2 d-flex align-items-end">
              <a href="/admin/bookings" class="btn btn-sm btn-outline-custom w-100">Reset</a>
            </div>
          </form>
        </div>

        <!-- Bookings Table -->
        <div class="card card-custom border-0 shadow-sm overflow-hidden">
          <% if (bookings && bookings.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-custom mb-0">
                <thead>
                  <tr>
                    <th>Event & Organiser</th>
                    <th>Venue</th>
                    <th>Date & Time</th>
                    <th>Expected</th>
                    <th>Tariff</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% bookings.forEach(function(b) { %>
                    <tr>
                      <td>
                        <div class="fw-bold text-dark"><%= b.eventName %></div>
                        <small class="text-muted"><%= b.organiser ? b.organiser.name : 'Unknown' %> (<%= b.organiser ? b.organiser.email : '' %>)</small>
                      </td>
                      <td>
                        <div class="fw-semibold text-dark"><%= b.venue ? b.venue.name : 'N/A' %></div>
                        <small class="text-muted">📍 <%= b.venue ? b.venue.location : '' %></small>
                      </td>
                      <td>
                        <div><%= formatDateDisplay(b.bookingDate) %></div>
                        <span class="badge bg-light text-dark border"><%= b.startTime %> – <%= b.endTime %></span>
                      </td>
                      <td><%= b.expectedAttendees %> pax</td>
                      <td class="fw-bold text-success"><%= formatCurrency(b.totalAmount) %></td>
                      <td>
                        <span class="badge badge-status badge-<%= b.status %>">
                          <%= b.status %>
                        </span>
                      </td>
                      <td class="text-end">
                        <a href="/admin/bookings/<%= b._id %>" class="btn btn-sm btn-outline-custom">
                          Review
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="p-5 text-center">
              <div class="stat-icon info mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.25rem;">🔍</div>
              <h6 class="fw-bold text-dark mb-1">No Bookings Found</h6>
              <p class="text-muted small mb-0">No booking records match the selected filter criteria.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%- include('../../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
