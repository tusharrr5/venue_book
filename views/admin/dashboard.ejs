<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="admin-theme">
  <%- include('../partials/navbar') %>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <!-- Admin Sidebar -->
      <div class="col-lg-2 p-0 d-none d-lg-block">
        <%- include('../partials/adminSidebar') %>
      </div>

      <!-- Main Content -->
      <div class="col-lg-10 p-4 p-md-5 admin-content">
        <%- include('../partials/flash') %>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 animate-fade-in-up">
          <div>
            <h1 class="fw-bold mb-1" style="font-size: 1.75rem;">Admin Command Center</h1>
            <p class="mb-0" style="color: var(--admin-text-muted);">Overview of campus spaces, pending approvals, revenue, and daily reservations.</p>
          </div>
          <div class="d-flex gap-2">
            <a href="/admin/venues/new" class="btn btn-outline-custom btn-sm">+ New Venue</a>
            <a href="/admin/blocks" class="btn btn-outline-custom btn-sm">+ Block</a>
            <a href="/admin/reports" class="btn btn-primary-custom btn-sm">View Analytics</a>
          </div>
        </div>

        <!-- Summary KPI Cards -->
        <div class="row g-3 mb-4 stagger-children">
          <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
              <div class="stat-icon primary">🏛️</div>
              <div>
                <div class="stat-value"><%= stats.totalVenues %></div>
                <div class="stat-label">Total Venues (<%= stats.activeVenues %> Active)</div>
              </div>
            </div>
          </div>

          <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
              <div class="stat-icon warning">⏳</div>
              <div>
                <div class="stat-value"><%= stats.pendingCount %></div>
                <div class="stat-label">Pending Requests</div>
              </div>
            </div>
          </div>

          <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
              <div class="stat-icon info">📅</div>
              <div>
                <div class="stat-value"><%= stats.todayEventsCount %></div>
                <div class="stat-label">Today's Events</div>
              </div>
            </div>
          </div>

          <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
              <div class="stat-icon success">💰</div>
              <div>
                <div class="stat-value" style="font-size: 1.4rem;"><%= formatCurrency(stats.totalRevenue) %></div>
                <div class="stat-label">Completed Revenue</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Two Columns: Pending Approvals & Today's Events -->
        <div class="row g-4 mb-4">
          <!-- Pending Approval Requests -->
          <div class="col-lg-7">
            <div class="card card-custom border-0 h-100">
              <div class="card-header border-bottom p-4 d-flex justify-content-between align-items-center">
                <div>
                  <h5 class="fw-bold mb-0">Pending Approval Requests</h5>
                  <small style="color: var(--admin-text-muted);">Awaiting administrative decision</small>
                </div>
                <a href="/admin/bookings?status=pending" class="btn btn-sm btn-outline-custom">View All</a>
              </div>

              <% if (pendingRequests && pendingRequests.length > 0) { %>
                <div class="table-responsive">
                  <table class="table table-custom mb-0">
                    <thead>
                      <tr>
                        <th>Event & Organiser</th>
                        <th>Venue</th>
                        <th>Date & Time</th>
                        <th class="text-end">Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% pendingRequests.forEach(function(b) { %>
                        <tr>
                          <td>
                            <div class="fw-bold"><%= b.eventName %></div>
                            <small style="color: var(--admin-text-muted);"><%= b.organiser ? b.organiser.name : 'Unknown' %></small>
                          </td>
                          <td><%= b.venue ? b.venue.name : 'N/A' %></td>
                          <td>
                            <div><%= formatDateDisplay(b.bookingDate) %></div>
                            <span class="badge rounded-pill" style="background: rgba(255,255,255,0.06); color: var(--admin-text-secondary); font-size: 0.72rem;"><%= b.startTime %> – <%= b.endTime %></span>
                          </td>
                          <td class="text-end">
                            <a href="/admin/bookings/<%= b._id %>" class="btn btn-sm btn-primary-custom">Review</a>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <div class="empty-state">
                  <div class="empty-state-icon success">✓</div>
                  <h6 class="fw-bold mb-1">No Pending Requests</h6>
                  <p class="small mb-0" style="color: var(--admin-text-muted);">All booking requests have been reviewed.</p>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Today's Events Schedule -->
          <div class="col-lg-5">
            <div class="card card-custom border-0 h-100">
              <div class="card-header border-bottom p-4 d-flex justify-content-between align-items-center">
                <div>
                  <h5 class="fw-bold mb-0">Today's Campus Events</h5>
                  <small style="color: var(--admin-text-muted);">Happening today on campus</small>
                </div>
                <a href="/admin/events/today" class="btn btn-sm btn-outline-custom">Full Schedule</a>
              </div>

              <% if (todayEvents && todayEvents.length > 0) { %>
                <div class="p-4 d-flex flex-column gap-3">
                  <% todayEvents.forEach(function(ev) { %>
                    <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                      <div>
                        <div class="fw-bold"><%= ev.eventName %></div>
                        <small style="color: var(--admin-text-muted);">🏛️ <%= ev.venue ? ev.venue.name : 'N/A' %> | 👤 <%= ev.organiser ? ev.organiser.name : 'Organiser' %></small>
                      </div>
                      <div class="text-end">
                        <span class="badge rounded-pill" style="background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; font-size: 0.72rem;"><%= ev.startTime %> – <%= ev.endTime %></span>
                        <div class="small mt-1" style="color: var(--admin-text-muted); text-transform: capitalize;"><%= ev.status %></div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="empty-state">
                  <div class="empty-state-icon info">📅</div>
                  <h6 class="fw-bold mb-1">No Events Today</h6>
                  <p class="small mb-0" style="color: var(--admin-text-muted);">No approved events are scheduled for today.</p>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Upcoming Events & Recent Activity -->
        <div class="row g-4">
          <!-- Upcoming Events -->
          <div class="col-lg-6">
            <div class="card card-custom border-0 h-100">
              <div class="card-header border-bottom p-4 d-flex justify-content-between align-items-center">
                <div>
                  <h5 class="fw-bold mb-0">Upcoming Approved Events</h5>
                  <small style="color: var(--admin-text-muted);">Confirmed future bookings</small>
                </div>
                <a href="/admin/events/upcoming" class="btn btn-sm btn-outline-custom">View All</a>
              </div>

              <% if (upcomingEvents && upcomingEvents.length > 0) { %>
                <div class="table-responsive">
                  <table class="table table-custom mb-0">
                    <thead>
                      <tr>
                        <th>Event</th>
                        <th>Venue</th>
                        <th>Date & Time</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% upcomingEvents.forEach(function(ev) { %>
                        <tr>
                          <td>
                            <div class="fw-bold"><%= ev.eventName %></div>
                            <small style="color: var(--admin-text-muted);"><%= ev.organiser ? ev.organiser.name : 'N/A' %></small>
                          </td>
                          <td><%= ev.venue ? ev.venue.name : 'N/A' %></td>
                          <td>
                            <div><%= formatDateDisplay(ev.bookingDate) %></div>
                            <span class="badge rounded-pill" style="background: rgba(255,255,255,0.06); color: var(--admin-text-secondary); font-size: 0.72rem;"><%= ev.startTime %> – <%= ev.endTime %></span>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <div class="p-4 text-center small" style="color: var(--admin-text-muted);">No upcoming events scheduled.</div>
              <% } %>
            </div>
          </div>

          <!-- Recent Activity -->
          <div class="col-lg-6">
            <div class="card card-custom border-0 h-100">
              <div class="card-header border-bottom p-4">
                <h5 class="fw-bold mb-0">Recent Activity</h5>
                <small style="color: var(--admin-text-muted);">Latest booking submissions and status updates</small>
              </div>

              <% if (recentActivity && recentActivity.length > 0) { %>
                <div class="p-4 d-flex flex-column gap-2 overflow-auto" style="max-height: 320px;">
                  <% recentActivity.forEach(function(item) { %>
                    <div class="p-3 rounded-3 d-flex justify-content-between align-items-center small" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
                      <div>
                        <strong>"<%= item.eventName %>"</strong> in <%= item.venue ? item.venue.name : 'Venue' %>
                        <div style="font-size: 0.78rem; color: var(--admin-text-muted);">By <%= item.organiser ? item.organiser.name : 'User' %> on <%= formatDateDisplay(item.updatedAt) %></div>
                      </div>
                      <span class="badge badge-status badge-<%= item.status %>">
                        <%= item.status %>
                      </span>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="p-4 text-center small" style="color: var(--admin-text-muted);">No recent activity recorded.</div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
