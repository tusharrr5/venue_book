<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100 admin-theme">
  <%- include('../../partials/navbar') %>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <div class="col-lg-2 p-0 d-none d-lg-block">
        <%- include('../../partials/adminSidebar') %>
      </div>

      <div class="col-lg-10 p-4 p-md-5 admin-content">
        <%- include('../../partials/flash') %>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 animate-fade-in-up">
          <div>
            <h1 class="fw-bold mb-1" style="font-size: 1.75rem;">Upcoming Campus Events</h1>
            <p class="mb-0" style="color: var(--admin-text-muted);">List of approved future events sorted chronologically by nearest date.</p>
          </div>
        </div>

        <!-- Filter Bar -->
        <div class="card card-custom p-3 border-0 shadow-sm mb-4 animate-fade-in-up" style="animation-delay: 0.1s;">
          <form action="/admin/events/upcoming" method="GET" class="row g-3 align-items-center">
            <div class="col-md-4">
              <label class="form-label small fw-semibold mb-1" style="color: var(--admin-text-muted);">Filter by Venue</label>
              <select class="form-select form-select-sm" name="venueId" onchange="this.form.submit()">
                <option value="">All Venues</option>
                <% venues.forEach(function(v) { %>
                  <option value="<%= v._id %>" <%= filters.venueId === v._id.toString() ? 'selected' : '' %>><%= v.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="col-md-3">
              <label class="form-label small fw-semibold mb-1" style="color: var(--admin-text-muted);">Filter by Date</label>
              <input type="date" class="form-control form-control-sm" name="date" value="<%= filters.date %>" onchange="this.form.submit()">
            </div>

            <div class="col-md-3">
              <label class="form-label small fw-semibold mb-1" style="color: var(--admin-text-muted);">Organiser Search</label>
              <input type="text" class="form-control form-control-sm" name="organiser" placeholder="Name or email..." value="<%= filters.organiser %>">
            </div>

            <div class="col-md-2 d-flex align-items-end gap-2">
              <button type="submit" class="btn btn-sm btn-primary-custom w-50 py-1.5">Filter</button>
              <a href="/admin/events/upcoming" class="btn btn-sm btn-outline-custom w-50 py-1.5">Reset</a>
            </div>
          </form>
        </div>

        <!-- Upcoming Events Table -->
        <div class="card card-custom border-0 shadow-sm overflow-hidden animate-fade-in-up" style="animation-delay: 0.2s;">
          <% if (events && events.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-custom mb-0">
                <thead>
                  <tr>
                    <th>Event</th>
                    <th>Venue</th>
                    <th>Date</th>
                    <th>Time Interval</th>
                    <th>Organiser</th>
                    <th>Expected</th>
                    <th class="text-end">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% events.forEach(function(ev) { %>
                    <tr>
                      <td>
                        <div class="fw-bold"><%= ev.eventName %></div>
                        <small style="color: var(--admin-text-muted);"><%= ev.durationHours %> hours</small>
                      </td>
                      <td>
                        <div class="fw-semibold"><%= ev.venue ? ev.venue.name : 'N/A' %></div>
                        <small style="color: var(--admin-text-muted);">📍 <%= ev.venue ? ev.venue.location : '' %></small>
                      </td>
                      <td>
                        <strong style="color: var(--admin-text);"><%= formatDateDisplay(ev.bookingDate) %></strong>
                      </td>
                      <td>
                        <span class="badge rounded-pill" style="background: rgba(255,255,255,0.06); color: var(--admin-text-secondary); border: 1px solid rgba(255,255,255,0.1);"><%= ev.startTime %> – <%= ev.endTime %></span>
                      </td>
                      <td>
                        <div style="color: var(--admin-text-secondary);"><%= ev.organiser ? ev.organiser.name : 'Organiser' %></div>
                        <small style="color: var(--admin-text-muted);"><%= ev.organiser ? ev.organiser.email : '' %></small>
                      </td>
                      <td style="color: var(--admin-text-secondary);"><%= ev.expectedAttendees %> pax</td>
                      <td class="text-end">
                        <a href="/admin/bookings/<%= ev._id %>" class="btn btn-sm btn-outline-custom px-3">
                          Review
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-state-icon info" style="background: rgba(99,102,241,0.15);">📅</div>
              <h5 class="fw-bold mb-1">No Upcoming Events</h5>
              <p class="small mb-0" style="color: var(--admin-text-muted);">No approved bookings match the selected filters.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%- include('../../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
