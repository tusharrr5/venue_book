<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100 admin-theme">
  <%- include('../../partials/navbar') %>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <div class="col-lg-2 p-0 d-none d-lg-block">
        <%- include('../../partials/adminSidebar') %>
      </div>

      <div class="col-lg-10 p-4 p-md-5 admin-content">
        <%- include('../../partials/flash') %>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 animate-fade-in-up">
          <div>
            <h1 class="fw-bold mb-1" style="font-size: 1.75rem;">Today's Campus Schedule</h1>
            <p class="mb-0" style="color: var(--admin-text-muted);">Chronological timeline of events happening across campus on <strong style="color: var(--admin-text);"><%= formatDateDisplay(todayStr) %></strong>.</p>
          </div>
        </div>

        <div class="card card-custom border-0 shadow-sm overflow-hidden animate-fade-in-up" style="animation-delay: 0.1s;">
          <% if (events && events.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-custom mb-0">
                <thead>
                  <tr>
                    <th>Time Slot</th>
                    <th>Event</th>
                    <th>Venue</th>
                    <th>Organiser</th>
                    <th>Expected</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% events.forEach(function(ev) { %>
                    <tr>
                      <td>
                        <span class="badge rounded-pill fw-medium fs-6 py-2 px-3" style="background: rgba(99,102,241,0.2); color: #a5b4fc; border: 1px solid rgba(99,102,241,0.3);">
                          <%= ev.startTime %> – <%= ev.endTime %>
                        </span>
                      </td>
                      <td>
                        <div class="fw-bold"><%= ev.eventName %></div>
                        <small style="color: var(--admin-text-muted);"><%= ev.durationHours %> hours</small>
                      </td>
                      <td>
                        <div class="fw-semibold"><%= ev.venue ? ev.venue.name : 'N/A' %></div>
                        <small style="color: var(--admin-text-muted);">📍 <%= ev.venue ? ev.venue.location : '' %></small>
                      </td>
                      <td>
                        <div style="color: var(--admin-text-secondary);"><%= ev.organiser ? ev.organiser.name : 'Organiser' %></div>
                        <small style="color: var(--admin-text-muted);"><%= ev.organiser ? ev.organiser.email : '' %></small>
                      </td>
                      <td style="color: var(--admin-text-secondary);"><%= ev.expectedAttendees %> attendees</td>
                      <td>
                        <span class="badge badge-status badge-<%= ev.status %>">
                          <%= ev.status %>
                        </span>
                      </td>
                      <td class="text-end">
                        <a href="/admin/bookings/<%= ev._id %>" class="btn btn-sm btn-outline-custom px-3">
                          View Details
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-state-icon info" style="background: rgba(99,102,241,0.15);">📅</div>
              <h5 class="fw-bold mb-1">No Events Scheduled Today</h5>
              <p class="small mb-0" style="color: var(--admin-text-muted);">No approved or completed bookings are listed for <%= formatDateDisplay(todayStr) %>.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%- include('../../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
