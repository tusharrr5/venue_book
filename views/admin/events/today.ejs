<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../../partials/navbar') %>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <div class="col-lg-2 p-0 d-none d-lg-block">
        <%- include('../../partials/adminSidebar') %>
      </div>

      <div class="col-lg-10 p-4 p-md-5">
        <%- include('../../partials/flash') %>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
          <div>
            <h1 class="fw-bold text-dark mb-1">Today's Campus Schedule</h1>
            <p class="text-muted mb-0">Chronological timeline of events happening across campus on <strong><%= formatDateDisplay(todayStr) %></strong>.</p>
          </div>
        </div>

        <div class="card card-custom border-0 shadow-sm overflow-hidden">
          <% if (events && events.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-custom mb-0">
                <thead>
                  <tr>
                    <th>Time Slot</th>
                    <th>Event</th>
                    <th>Venue</th>
                    <th>Organiser</th>
                    <th>Expected</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% events.forEach(function(ev) { %>
                    <tr>
                      <td>
                        <span class="badge bg-primary text-white fs-6 py-2 px-3">
                          <%= ev.startTime %> – <%= ev.endTime %>
                        </span>
                      </td>
                      <td>
                        <div class="fw-bold text-dark"><%= ev.eventName %></div>
                        <small class="text-muted"><%= ev.durationHours %> hours</small>
                      </td>
                      <td>
                        <div class="fw-semibold text-dark"><%= ev.venue ? ev.venue.name : 'N/A' %></div>
                        <small class="text-muted">📍 <%= ev.venue ? ev.venue.location : '' %></small>
                      </td>
                      <td>
                        <div><%= ev.organiser ? ev.organiser.name : 'Organiser' %></div>
                        <small class="text-muted"><%= ev.organiser ? ev.organiser.email : '' %></small>
                      </td>
                      <td><%= ev.expectedAttendees %> attendees</td>
                      <td>
                        <span class="badge badge-status badge-<%= ev.status %>">
                          <%= ev.status %>
                        </span>
                      </td>
                      <td class="text-end">
                        <a href="/admin/bookings/<%= ev._id %>" class="btn btn-sm btn-outline-custom">
                          View Details
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="p-5 text-center">
              <div class="stat-icon info mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.25rem;">📅</div>
              <h5 class="fw-bold text-dark mb-1">No Events Scheduled Today</h5>
              <p class="text-muted small mb-0">No approved or completed bookings are listed for <%= formatDateDisplay(todayStr) %>.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%- include('../../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
