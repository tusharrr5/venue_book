<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100 admin-theme">
  <%- include('../../partials/navbar') %>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <div class="col-lg-2 p-0 d-none d-lg-block">
        <%- include('../../partials/adminSidebar') %>
      </div>

      <div class="col-lg-10 p-4 p-md-5 admin-content">
        <%- include('../../partials/flash') %>

        <div class="row justify-content-center animate-fade-in-up">
          <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-4">
              <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/dashboard" class="text-decoration-none hover-lift" style="color: var(--admin-text-muted);">Admin</a></li>
                <li class="breadcrumb-item"><a href="/admin/venues" class="text-decoration-none hover-lift" style="color: var(--admin-text-muted);">Venues</a></li>
                <li class="breadcrumb-item active fw-medium" aria-current="page">New Venue</li>
              </ol>
            </nav>

            <div class="card card-custom p-4 p-md-5 border-0 shadow-sm" style="border-radius: var(--radius-xl);">
              <div class="text-center mb-5">
                <div class="stat-icon primary mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem; background: rgba(99,102,241,0.15);">🏛️</div>
                <h2 class="fw-bold mb-2" style="color: var(--admin-text);">Add New Campus Venue</h2>
                <p class="mb-0" style="color: var(--admin-text-muted);">Register a new room, hall, lab or auditorium in the campus booking system.</p>
              </div>

              <form action="/admin/venues" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="mb-4">
                  <label for="name" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--admin-text-secondary);">Venue Name</label>
                  <input
                    type="text"
                    class="form-control form-control-lg"
                    id="name"
                    name="name"
                    value="<%= oldInput.name || '' %>"
                    required
                    placeholder="e.g. Einstein Seminar Hall"
                  >
                </div>

                <div class="mb-4">
                  <label for="location" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--admin-text-secondary);">Campus Location / Block</label>
                  <input
                    type="text"
                    class="form-control form-control-lg"
                    id="location"
                    name="location"
                    value="<%= oldInput.location || '' %>"
                    required
                    placeholder="e.g. Science Complex, 2nd Floor, Room 204"
                  >
                </div>

                <div class="mb-4">
                  <label for="description" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--admin-text-secondary);">Description</label>
                  <textarea
                    class="form-control"
                    id="description"
                    name="description"
                    rows="4"
                    required
                    placeholder="Provide overview, ideal events, acoustic qualities, etc."
                  ><%= oldInput.description || '' %></textarea>
                </div>

                <div class="row g-4 mb-4">
                  <div class="col-md-6">
                    <label for="capacity" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--admin-text-secondary);">Capacity (People)</label>
                    <input
                      type="number"
                      class="form-control form-control-lg"
                      id="capacity"
                      name="capacity"
                      value="<%= oldInput.capacity || '' %>"
                      required
                      min="1"
                      placeholder="e.g. 150"
                    >
                  </div>
                  <div class="col-md-6">
                    <label for="hourlyRate" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--admin-text-secondary);">Hourly Rate (₹)</label>
                    <input
                      type="number"
                      class="form-control form-control-lg"
                      id="hourlyRate"
                      name="hourlyRate"
                      value="<%= oldInput.hourlyRate || '' %>"
                      required
                      min="0"
                      placeholder="e.g. 1500"
                    >
                  </div>
                </div>

                <div class="mb-5">
                  <label for="imageUrl" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--admin-text-secondary);">Image URL (Optional)</label>
                  <input
                    type="url"
                    class="form-control form-control-lg"
                    id="imageUrl"
                    name="imageUrl"
                    value="<%= oldInput.imageUrl || '' %>"
                    placeholder="https://images.unsplash.com/..."
                  >
                  <small class="mt-2 d-block" style="color: var(--admin-text-muted);">Leave empty to use default campus venue image.</small>
                </div>

                <div class="divider mb-4"></div>

                <!-- Facilities Multi-select checkboxes -->
                <div class="mb-5">
                  <label class="form-label fw-semibold small text-uppercase mb-3" style="letter-spacing: 0.05em; color: var(--admin-text-secondary);">Facilities & Equipment Available</label>
                  <div class="row g-3">
                    <% allFacilities.forEach(function(fac) { %>
                      <div class="col-sm-6 col-md-4">
                        <div class="form-check custom-check p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
                          <input
                            class="form-check-input ms-0 me-2"
                            type="checkbox"
                            name="facilities"
                            value="<%= fac %>"
                            id="fac_<%= fac.replace(/[^a-zA-Z0-9]/g, '_') %>"
                            style="margin-top: 0.15rem;"
                          >
                          <label class="form-check-label small w-100 stretched-link" for="fac_<%= fac.replace(/[^a-zA-Z0-9]/g, '_') %>" style="color: var(--admin-text); cursor: pointer;">
                            <%= fac %>
                          </label>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                  <a href="/admin/venues" class="btn btn-outline-custom px-4 py-2">Cancel</a>
                  <button type="submit" class="btn btn-primary-custom px-5 py-2 fs-6 hover-lift" style="background: linear-gradient(135deg, #6366f1, #4f46e5); border: none;">
                    Create Venue
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Ensure the stretched link works well inside the custom checkbox card */
    .custom-check {
      position: relative;
      transition: var(--transition-fast);
    }
    .custom-check:hover {
      background: rgba(99,102,241,0.08) !important;
      border-color: rgba(99,102,241,0.2) !important;
    }
    .custom-check:has(.form-check-input:checked) {
      background: rgba(99,102,241,0.15) !important;
      border-color: rgba(99,102,241,0.3) !important;
    }
    .admin-theme .custom-check .form-check-input {
      background-color: rgba(255,255,255,0.1);
      border-color: rgba(255,255,255,0.2);
    }
    .admin-theme .custom-check .form-check-input:checked {
      background-color: var(--color-primary);
      border-color: var(--color-primary);
    }
  </style>

  <%- include('../../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
