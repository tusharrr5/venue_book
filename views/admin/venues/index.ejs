<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../../partials/navbar') %>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <!-- Admin Sidebar -->
      <div class="col-lg-2 p-0 d-none d-lg-block">
        <%- include('../../partials/adminSidebar') %>
      </div>

      <!-- Main Content -->
      <div class="col-lg-10 p-4 p-md-5">
        <%- include('../../partials/flash') %>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
          <div>
            <h1 class="fw-bold text-dark mb-1">Campus Venues Directory</h1>
            <p class="text-muted mb-0">Create, update, toggle availability status, and manage all campus spaces.</p>
          </div>
          <div>
            <a href="/admin/venues/new" class="btn btn-primary-custom d-flex align-items-center gap-2">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Add New Venue
            </a>
          </div>
        </div>

        <div class="card card-custom border-0 shadow-sm overflow-hidden">
          <div class="table-responsive">
            <table class="table table-custom mb-0">
              <thead>
                <tr>
                  <th>Venue</th>
                  <th>Location</th>
                  <th>Capacity</th>
                  <th>Tariff</th>
                  <th>Status</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% venues.forEach(function(v) { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-3">
                        <img
                          src="<%= v.imageUrl %>"
                          alt="<%= v.name %>"
                          class="rounded-2"
                          style="width: 50px; height: 50px; object-fit: cover;"
                          onerror="this.src='https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=200&q=80'"
                        >
                        <div>
                          <div class="fw-bold text-dark"><%= v.name %></div>
                          <small class="text-muted"><%= (v.facilities || []).length %> facilities listed</small>
                        </div>
                      </div>
                    </td>
                    <td><%= v.location %></td>
                    <td><strong><%= v.capacity %></strong> pax</td>
                    <td class="fw-bold text-primary"><%= formatCurrency(v.hourlyRate) %>/hr</td>
                    <td>
                      <span class="badge badge-status <%= v.status === 'active' ? 'badge-active' : 'badge-inactive' %>">
                        <%= v.status %>
                      </span>
                    </td>
                    <td class="text-end">
                      <div class="d-flex justify-content-end gap-2">
                        <form action="/admin/venues/<%= v._id %>/toggle-status" method="POST" class="d-inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-sm <%= v.status === 'active' ? 'btn-outline-warning' : 'btn-outline-success' %>" title="Toggle Active/Inactive">
                            <%= v.status === 'active' ? 'Deactivate' : 'Activate' %>
                          </button>
                        </form>

                        <a href="/admin/venues/<%= v._id %>/edit" class="btn btn-sm btn-outline-custom">
                          Edit
                        </a>

                        <button
                          type="button"
                          class="btn btn-sm btn-outline-danger"
                          data-bs-toggle="modal"
                          data-bs-target="#deleteVenueModal_<%= v._id %>"
                        >
                          Delete
                        </button>
                      </div>

                      <!-- Delete Modal -->
                      <div class="modal fade text-start" id="deleteVenueModal_<%= v._id %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content border-0 shadow">
                            <form action="/admin/venues/<%= v._id %>?_method=DELETE" method="POST">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <div class="modal-header border-bottom">
                                <h5 class="modal-title fw-bold text-dark">Delete Venue</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                              </div>
                              <div class="modal-body p-4">
                                <p class="text-muted mb-2">
                                  Are you sure you want to delete <strong>"<%= v.name %>"</strong>?
                                </p>
                                <p class="text-muted small mb-0">
                                  Note: If this venue has historical bookings, the system will automatically deactivate it instead of permanently deleting records, preserving audit history.
                                </p>
                              </div>
                              <div class="modal-footer border-top">
                                <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Confirm Delete / Deactivate</button>
                              </div>
                            </form>
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
