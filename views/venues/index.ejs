<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container py-5">
    <%- include('../partials/flash') %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
      <div>
        <h1 class="fw-bold text-dark mb-1">Discover Campus Venues</h1>
        <p class="text-muted mb-0">Browse and filter venues for academic lectures, conferences, hackathons, and cultural events.</p>
      </div>
      <div class="text-muted small">
        Showing <strong><%= venues.length %></strong> active venue<%= venues.length === 1 ? '' : 's' %>
      </div>
    </div>

    <div class="row g-4">
      <!-- Filter Sidebar -->
      <div class="col-lg-3">
        <div class="card card-custom p-4 border-0 shadow-sm sticky-top" style="top: 90px;">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">Filter Venues</h5>
            <a href="/venues" class="text-muted small text-decoration-none">Reset</a>
          </div>

          <form action="/venues" method="GET">
            <!-- Search Text -->
            <div class="mb-3">
              <label for="search" class="form-label small fw-semibold text-muted">Search Keyword</label>
              <input
                type="text"
                class="form-control form-control-sm"
                id="search"
                name="search"
                placeholder="Name, block, keyword..."
                value="<%= filters.search %>"
              >
            </div>

            <!-- Capacity Range -->
            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted">Capacity Range</label>
              <div class="row g-2">
                <div class="col-6">
                  <input
                    type="number"
                    class="form-control form-control-sm"
                    name="minCapacity"
                    placeholder="Min"
                    value="<%= filters.minCapacity %>"
                    min="1"
                  >
                </div>
                <div class="col-6">
                  <input
                    type="number"
                    class="form-control form-control-sm"
                    name="maxCapacity"
                    placeholder="Max"
                    value="<%= filters.maxCapacity %>"
                    min="1"
                  >
                </div>
              </div>
            </div>

            <!-- Max Hourly Rate -->
            <div class="mb-3">
              <label for="maxRate" class="form-label small fw-semibold text-muted">Max Hourly Rate (₹)</label>
              <input
                type="number"
                class="form-control form-control-sm"
                id="maxRate"
                name="maxRate"
                placeholder="e.g. 2500"
                value="<%= filters.maxRate %>"
                min="0"
              >
            </div>

            <!-- Multi-facility Checkboxes -->
            <div class="mb-4">
              <label class="form-label small fw-semibold text-muted mb-2">Required Facilities</label>
              <div class="d-flex flex-column gap-1 overflow-auto" style="max-height: 220px;">
                <% allFacilities.forEach(function(facility) { %>
                  <div class="form-check">
                    <input
                      class="form-check-input"
                      type="checkbox"
                      name="facilities"
                      value="<%= facility %>"
                      id="fac_<%= facility.replace(/[^a-zA-Z0-9]/g, '_') %>"
                      <%= selectedFacilities.includes(facility) ? 'checked' : '' %>
                    >
                    <label class="form-check-label small" for="fac_<%= facility.replace(/[^a-zA-Z0-9]/g, '_') %>">
                      <%= facility %>
                    </label>
                  </div>
                <% }); %>
              </div>
            </div>

            <button type="submit" class="btn btn-primary-custom btn-sm w-100 py-2">
              Apply Filters
            </button>
          </form>
        </div>
      </div>

      <!-- Venues Grid -->
      <div class="col-lg-9">
        <% if (venues && venues.length > 0) { %>
          <div class="row g-4">
            <% venues.forEach(function(venue) { %>
              <div class="col-md-6">
                <div class="card card-custom h-100 d-flex flex-column">
                  <img
                    src="<%= venue.imageUrl %>"
                    class="card-venue-img"
                    alt="<%= venue.name %>"
                    onerror="this.src='https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=800&q=80'"
                  >
                  <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <h5 class="card-title fw-bold text-dark mb-0"><%= venue.name %></h5>
                      <span class="badge badge-status <%= venue.status === 'active' ? 'badge-active' : 'badge-inactive' %>">
                        <%= venue.status %>
                      </span>
                    </div>

                    <p class="text-muted small mb-2">📍 <%= venue.location %></p>
                    <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                      <%= venue.description %>
                    </p>

                    <!-- Facilities Pills -->
                    <div class="d-flex flex-wrap gap-1 mb-3">
                      <% (venue.facilities || []).slice(0, 4).forEach(function(f) { %>
                        <span class="facility-pill"><%= f %></span>
                      <% }); %>
                      <% if (venue.facilities && venue.facilities.length > 4) { %>
                        <span class="facility-pill">+<%= venue.facilities.length - 4 %> more</span>
                      <% } %>
                    </div>

                    <div class="border-top pt-3 d-flex justify-content-between align-items-center mt-auto">
                      <div>
                        <div class="fw-bold text-dark fs-5"><%= formatCurrency(venue.hourlyRate) %><span class="text-muted fw-normal fs-6">/hr</span></div>
                        <small class="text-muted">Capacity: <strong><%= venue.capacity %></strong> attendees</small>
                      </div>
                      <div class="d-flex gap-2">
                        <a href="/venues/<%= venue._id %>" class="btn btn-outline-custom btn-sm">
                          Details
                        </a>
                        <a href="/bookings/new/<%= venue._id %>" class="btn btn-primary-custom btn-sm">
                          Book
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="card card-custom p-5 text-center border-0">
            <div class="stat-icon info mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.75rem;">
              🏛️
            </div>
            <h4 class="fw-bold text-dark">No Venues Match Your Filters</h4>
            <p class="text-muted mb-4">Try relaxing your capacity or facility criteria to view available campus spaces.</p>
            <div>
              <a href="/venues" class="btn btn-outline-custom">Clear All Filters</a>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
