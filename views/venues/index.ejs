<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container py-5">
    <%- include('../partials/flash') %>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 animate-fade-in-up">
      <div>
        <h1 class="fw-bold text-dark mb-1">Discover Campus Venues</h1>
        <p class="text-muted mb-0">Browse and filter venues for academic lectures, conferences, hackathons, and cultural events.</p>
      </div>
      <div class="text-muted small">
        Showing <strong class="text-dark"><%= venues.length %></strong> active venue<%= venues.length === 1 ? '' : 's' %>
      </div>
    </div>

    <div class="row g-4 stagger-children">
      <!-- Filter Sidebar -->
      <div class="col-lg-3">
        <div class="card card-custom p-4 border-0 shadow-sm sticky-top" style="top: 90px; border-radius: var(--radius-xl);">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">Filter Venues</h5>
            <a href="/venues" class="text-primary small text-decoration-none fw-semibold hover-lift">Reset</a>
          </div>

          <form action="/venues" method="GET">
            <!-- Search Text -->
            <div class="mb-3">
              <label for="search" class="form-label small">Search Keyword</label>
              <input
                type="text"
                class="form-control"
                id="search"
                name="search"
                placeholder="Name, block, keyword..."
                value="<%= filters.search %>"
              >
            </div>

            <!-- Capacity Range -->
            <div class="mb-3">
              <label class="form-label small">Capacity Range</label>
              <div class="row g-2">
                <div class="col-6">
                  <input
                    type="number"
                    class="form-control"
                    name="minCapacity"
                    placeholder="Min"
                    value="<%= filters.minCapacity %>"
                    min="1"
                  >
                </div>
                <div class="col-6">
                  <input
                    type="number"
                    class="form-control"
                    name="maxCapacity"
                    placeholder="Max"
                    value="<%= filters.maxCapacity %>"
                    min="1"
                  >
                </div>
              </div>
            </div>

            <!-- Max Hourly Rate -->
            <div class="mb-3">
              <label for="maxRate" class="form-label small">Max Hourly Rate (₹)</label>
              <input
                type="number"
                class="form-control"
                id="maxRate"
                name="maxRate"
                placeholder="e.g. 2500"
                value="<%= filters.maxRate %>"
                min="0"
              >
            </div>

            <!-- Multi-facility Checkboxes -->
            <div class="mb-4">
              <label class="form-label small mb-2">Required Facilities</label>
              <div class="d-flex flex-column gap-2 overflow-auto pe-2 custom-scrollbar" style="max-height: 220px;">
                <% allFacilities.forEach(function(facility) { %>
                  <div class="form-check custom-check">
                    <input
                      class="form-check-input"
                      type="checkbox"
                      name="facilities"
                      value="<%= facility %>"
                      id="fac_<%= facility.replace(/[^a-zA-Z0-9]/g, '_') %>"
                      <%= selectedFacilities.includes(facility) ? 'checked' : '' %>
                    >
                    <label class="form-check-label small" for="fac_<%= facility.replace(/[^a-zA-Z0-9]/g, '_') %>">
                      <%= facility %>
                    </label>
                  </div>
                <% }); %>
              </div>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 py-2">
              Apply Filters
            </button>
          </form>
        </div>
      </div>

      <!-- Venues Grid -->
      <div class="col-lg-9">
        <% if (venues && venues.length > 0) { %>
          <div class="row g-4">
            <% venues.forEach(function(venue) { %>
              <div class="col-md-6">
                <div class="card card-custom h-100 d-flex flex-column" style="border-radius: var(--radius-xl);">
                  <div class="position-relative overflow-hidden" style="border-radius: var(--radius-xl) var(--radius-xl) 0 0;">
                    <img
                      src="<%= venue.imageUrl %>"
                      class="card-venue-img"
                      alt="<%= venue.name %>"
                      onerror="this.src='https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=800&q=80'"
                    >
                    <div class="position-absolute top-0 end-0 p-3">
                      <span class="badge badge-status <%= venue.status === 'active' ? 'badge-active' : 'badge-inactive' %> shadow-sm">
                        <%= venue.status %>
                      </span>
                    </div>
                  </div>
                  
                  <div class="card-body p-4 d-flex flex-column">
                    <h5 class="card-title fw-bold text-dark mb-2"><%= venue.name %></h5>
                    <p class="text-muted small mb-3"><svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg><%= venue.location %></p>
                    
                    <p class="text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6;">
                      <%= venue.description %>
                    </p>

                    <!-- Facilities Pills -->
                    <div class="d-flex flex-wrap gap-2 mb-4">
                      <% (venue.facilities || []).slice(0, 3).forEach(function(f) { %>
                        <span class="facility-pill"><%= f %></span>
                      <% }); %>
                      <% if (venue.facilities && venue.facilities.length > 3) { %>
                        <span class="facility-pill bg-light border-0 text-muted">+<%= venue.facilities.length - 3 %></span>
                      <% } %>
                    </div>

                    <div class="border-top pt-3 d-flex justify-content-between align-items-center mt-auto">
                      <div>
                        <div class="fw-bold text-dark fs-5"><%= formatCurrency(venue.hourlyRate) %><span class="text-muted fw-normal fs-6">/hr</span></div>
                        <small class="text-muted">Capacity: <strong class="text-dark"><%= venue.capacity %></strong> pax</small>
                      </div>
                      <div class="d-flex gap-2">
                        <a href="/venues/<%= venue._id %>" class="btn btn-outline-custom btn-sm">
                          Details
                        </a>
                        <a href="/bookings/new/<%= venue._id %>" class="btn btn-primary-custom btn-sm px-3">
                          Book
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="card card-custom p-5 text-center border-0 h-100 d-flex flex-column justify-content-center">
            <div class="empty-state">
              <div class="empty-state-icon text-muted" style="background: var(--color-border);">!</div>
              <h4 class="fw-bold text-dark mb-2">No Venues Match Your Filters</h4>
              <p class="text-muted mb-4">Try relaxing your capacity or facility criteria to view available campus spaces.</p>
              <div>
                <a href="/venues" class="btn btn-primary-custom px-4 py-2">Clear All Filters</a>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <style>
    /* Scoped minor adjustments */
    .custom-check .form-check-input:checked {
      background-color: var(--color-primary);
      border-color: var(--color-primary);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9; 
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1; 
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8; 
    }
  </style>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
