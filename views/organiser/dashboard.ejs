<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container py-5">
    <%- include('../partials/flash') %>

    <!-- Header & Quick Actions -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
      <div>
        <h1 class="fw-bold text-dark mb-1">Organiser Dashboard</h1>
        <p class="text-muted mb-0">Welcome back, <strong><%= currentUser.name %></strong>! Manage your event reservations and schedule.</p>
      </div>
      <div>
        <a href="/venues" class="btn btn-primary-custom d-flex align-items-center gap-2 shadow-sm">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Find a Venue
        </a>
      </div>
    </div>

    <!-- KPI Stat Cards -->
    <div class="row g-3 mb-4">
      <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-icon warning">⏳</div>
          <div>
            <div class="stat-value"><%= stats.pendingCount %></div>
            <div class="stat-label">Pending Requests</div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-icon primary">✓</div>
          <div>
            <div class="stat-value"><%= stats.approvedCount %></div>
            <div class="stat-label">Approved Bookings</div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-icon info">📅</div>
          <div>
            <div class="stat-value"><%= stats.upcomingCount %></div>
            <div class="stat-label">Upcoming Events</div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
          <div class="stat-icon success">🎉</div>
          <div>
            <div class="stat-value"><%= stats.completedCount %></div>
            <div class="stat-label">Completed Events</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Bookings Section -->
    <div class="card card-custom border-0 shadow-sm overflow-hidden mb-4">
      <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
        <div>
          <h5 class="fw-bold text-dark mb-0">Recent Booking Activity</h5>
          <small class="text-muted">Your latest reservation submissions and status changes</small>
        </div>
        <a href="/bookings" class="btn btn-sm btn-outline-custom">View All Bookings</a>
      </div>

      <% if (recentBookings && recentBookings.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-custom mb-0">
            <thead>
              <tr>
                <th>Event Name</th>
                <th>Venue</th>
                <th>Event Date</th>
                <th>Time Slot</th>
                <th>Total Tariff</th>
                <th>Status</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% recentBookings.forEach(function(b) { %>
                <tr>
                  <td>
                    <div class="fw-bold text-dark"><%= b.eventName %></div>
                    <small class="text-muted"><%= b.expectedAttendees %> attendees</small>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= b.venue ? b.venue.name : 'N/A' %></div>
                    <small class="text-muted">📍 <%= b.venue ? b.venue.location : '' %></small>
                  </td>
                  <td><%= formatDateDisplay(b.bookingDate) %></td>
                  <td>
                    <span class="badge bg-light text-dark border">
                      <%= b.startTime %> – <%= b.endTime %>
                    </span>
                  </td>
                  <td class="fw-bold text-success"><%= formatCurrency(b.totalAmount) %></td>
                  <td>
                    <span class="badge badge-status badge-<%= b.status %>">
                      <%= b.status %>
                    </span>
                  </td>
                  <td class="text-end">
                    <a href="/bookings/<%= b._id %>" class="btn btn-sm btn-outline-custom">
                      View
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="p-5 text-center">
          <p class="text-muted mb-3">You haven't requested any venue reservations yet.</p>
          <a href="/venues" class="btn btn-primary-custom">Explore Campus Venues</a>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
