<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || '403 Forbidden - VenueHub' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container my-auto py-5 text-center">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-5">
        <div class="card card-custom p-4 p-md-5 border-0 shadow-sm text-center">
          <div class="stat-icon danger mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
            🔒
          </div>
          <h1 class="display-5 fw-bold text-dark mb-2">403</h1>
          <h4 class="fw-semibold text-danger mb-3">Access Forbidden</h4>
          <p class="text-muted mb-4">
            <%= message || 'You do not have administrative privileges or permission to access this resource.' %>
          </p>
          <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-outline-custom">Back to Home</a>
            <% if (isAuthenticated) { %>
              <a href="/dashboard" class="btn btn-primary-custom">My Dashboard</a>
            <% } else { %>
              <a href="/login" class="btn btn-primary-custom">Sign In</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
