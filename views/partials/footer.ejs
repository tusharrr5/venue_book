          <% if (isAuthenticated) { %>
            <li><a href="<%= isAdmin ? '/admin/dashboard' : '/dashboard' %>" class="text-decoration-none text-muted">Dashboard</a></li>
          <% } else { %>
            <li><a href="/login" class="text-decoration-none text-muted">Sign In</a></li>
            <li><a href="/register" class="text-decoration-none text-muted">Create Account</a></li>
          <% } %>
        </ul>
      </div>
      <div class="col-lg-3 col-md-6">
