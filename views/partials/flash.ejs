<div class="toast-container" id="toastContainer">
  <% if (flash.success && flash.success.length > 0) { %>
    <% flash.success.forEach(function(msg) { %>
      <div class="toast-alert toast-success" role="alert">
        <svg class="toast-icon" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <div style="flex: 1; font-weight: 500;"><%= msg %></div>
        <button class="toast-close" onclick="this.parentElement.classList.add('toast-exiting'); setTimeout(() => this.parentElement.remove(), 300);">&times;</button>
        <div class="toast-progress"></div>
      </div>
    <% }); %>
  <% } %>

  <% if (flash.error && flash.error.length > 0) { %>
    <% flash.error.forEach(function(msg) { %>
      <div class="toast-alert toast-error" role="alert">
        <svg class="toast-icon" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
        </svg>
        <div style="flex: 1; font-weight: 500;"><%= msg %></div>
        <button class="toast-close" onclick="this.parentElement.classList.add('toast-exiting'); setTimeout(() => this.parentElement.remove(), 300);">&times;</button>
        <div class="toast-progress"></div>
      </div>
    <% }); %>
  <% } %>

  <% if (flash.warning && flash.warning.length > 0) { %>
    <% flash.warning.forEach(function(msg) { %>
      <div class="toast-alert toast-warning" role="alert">
        <svg class="toast-icon" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
        </svg>
        <div style="flex: 1; font-weight: 500;"><%= msg %></div>
        <button class="toast-close" onclick="this.parentElement.classList.add('toast-exiting'); setTimeout(() => this.parentElement.remove(), 300);">&times;</button>
        <div class="toast-progress"></div>
      </div>
    <% }); %>
  <% } %>

  <% if (flash.info && flash.info.length > 0) { %>
    <% flash.info.forEach(function(msg) { %>
      <div class="toast-alert toast-info" role="alert">
        <svg class="toast-icon" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
        </svg>
        <div style="flex: 1; font-weight: 500;"><%= msg %></div>
        <button class="toast-close" onclick="this.parentElement.classList.add('toast-exiting'); setTimeout(() => this.parentElement.remove(), 300);">&times;</button>
        <div class="toast-progress"></div>
      </div>
    <% }); %>
  <% } %>
</div>
