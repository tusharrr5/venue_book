<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container my-auto py-5">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-5">
        <%- include('../partials/flash') %>

        <div class="card card-custom p-4 p-md-5 border-0 shadow-sm">
          <div class="text-center mb-4">
            <h2 class="fw-bold text-dark">Welcome Back</h2>
            <p class="text-muted small">Sign in to manage your campus bookings and venue reservations</p>
          </div>

          <form action="/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <label for="email" class="form-label fw-semibold small text-muted">Email Address</label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                value="<%= oldInput.email || '' %>"
                required
                placeholder="e.g. organiser@campus.edu"
                autocomplete="email"
              >
            </div>

            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label for="password" class="form-label fw-semibold small text-muted mb-0">Password</label>
              </div>
              <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                required
                placeholder="Enter your password"
                autocomplete="current-password"
              >
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">
              Sign In to VenueHub
            </button>
          </form>

          <div class="alert alert-light border small text-muted mt-3 mb-0">
            <div class="fw-bold text-dark mb-1">Demo Credentials:</div>
            <div><strong>Admin:</strong> admin@campus.edu / Admin@123</div>
            <div><strong>Organiser:</strong> csclub@campus.edu / Organiser@123</div>
          </div>

          <div class="text-center mt-4">
            <p class="text-muted small mb-0">
              Don't have an organiser account? <a href="/register" class="text-primary fw-semibold text-decoration-none">Register here</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
