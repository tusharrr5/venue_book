<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="auth-wrapper d-flex align-items-center justify-content-center py-5" style="flex: 1;">
    <div class="container relative" style="z-index: 2;">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
          <%- include('../partials/flash') %>

          <div class="auth-card p-4 p-md-5">
            <div class="text-center mb-4">
              <div class="stat-icon primary mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.2rem; border-radius: 50%;">👋</div>
              <h2 class="fw-bold text-dark mb-2">Create Organiser Account</h2>
              <p class="text-muted small">Register to book venues, submit event proposals, and manage campus activities</p>
            </div>

            <form action="/register" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <div class="mb-3">
                <label for="name" class="form-label">Full Name</label>
                <input
                  type="text"
                  class="form-control form-control-lg"
                  id="name"
                  name="name"
                  value="<%= oldInput.name || '' %>"
                  required
                  placeholder="e.g. Computer Science Club"
                  autocomplete="name"
                  style="font-size: 0.95rem;"
                >
              </div>

              <div class="mb-3">
                <label for="email" class="form-label">Campus Email Address</label>
                <input
                  type="email"
                  class="form-control form-control-lg"
                  id="email"
                  name="email"
                  value="<%= oldInput.email || '' %>"
                  required
                  placeholder="e.g. organiser@campus.edu"
                  autocomplete="email"
                  style="font-size: 0.95rem;"
                >
              </div>

              <div class="row mb-4 g-3">
                <div class="col-sm-6">
                  <label for="password" class="form-label">Password</label>
                  <input
                    type="password"
                    class="form-control form-control-lg"
                    id="password"
                    name="password"
                    required
                    placeholder="Min 6 chars"
                    autocomplete="new-password"
                    style="font-size: 0.95rem;"
                  >
                </div>
                <div class="col-sm-6">
                  <label for="confirmPassword" class="form-label">Confirm Password</label>
                  <input
                    type="password"
                    class="form-control form-control-lg"
                    id="confirmPassword"
                    name="confirmPassword"
                    required
                    placeholder="Re-type password"
                    autocomplete="new-password"
                    style="font-size: 0.95rem;"
                  >
                </div>
              </div>

              <button type="submit" class="btn btn-primary-custom w-100 py-3 mb-4 fs-6 rounded-3">
                Create Account
              </button>
            </form>

            <div class="text-center">
              <p class="text-muted small mb-0">
                Already have an account? <br>
                <a href="/login" class="text-primary fw-bold text-decoration-none d-inline-block mt-1 hover-lift">Sign In here</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
