<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>

  <main class="container my-auto py-5">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-5">
        <%- include('../partials/flash') %>

        <div class="card card-custom p-4 p-md-5 border-0 shadow-sm">
          <div class="text-center mb-4">
            <h2 class="fw-bold text-dark">Create Organiser Account</h2>
            <p class="text-muted small">Register to book venues, submit event proposals, and manage campus activities</p>
          </div>

          <form action="/register" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <label for="name" class="form-label fw-semibold small text-muted">Full Name</label>
              <input
                type="text"
                class="form-control"
                id="name"
                name="name"
                value="<%= oldInput.name || '' %>"
                required
                placeholder="e.g. Computer Science Club"
                autocomplete="name"
              >
            </div>

            <div class="mb-3">
              <label for="email" class="form-label fw-semibold small text-muted">Campus Email Address</label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                value="<%= oldInput.email || '' %>"
                required
                placeholder="e.g. organiser@campus.edu"
                autocomplete="email"
              >
            </div>

            <div class="mb-3">
              <label for="password" class="form-label fw-semibold small text-muted">Password (min 6 characters)</label>
              <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                required
                placeholder="Create a strong password"
                autocomplete="new-password"
              >
            </div>

            <div class="mb-4">
              <label for="confirmPassword" class="form-label fw-semibold small text-muted">Confirm Password</label>
              <input
                type="password"
                class="form-control"
                id="confirmPassword"
                name="confirmPassword"
                required
                placeholder="Re-type your password"
                autocomplete="new-password"
              >
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">
              Create Account
            </button>
          </form>

          <div class="text-center mt-3">
            <p class="text-muted small mb-0">
              Already have an account? <a href="/login" class="text-primary fw-semibold text-decoration-none">Sign In here</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
